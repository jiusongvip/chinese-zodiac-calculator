---
import "../styles/global.css";
import playfairDisplay700Url from "@fontsource/playfair-display/files/playfair-display-latin-700-normal.woff2?url";

export interface Props {
  title: string;
  description: string;
  breadcrumbs?: { label: string; href: string }[];
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  articleSchema?: boolean;
  websiteSchema?: boolean;
  faqSchema?: { q: string; a: string }[];
  webApp?: boolean;
  datePublished?: string;
  dateModified?: string;
  ogImage?: string;
}

const { title, description, breadcrumbs, noindex, schema, articleSchema, websiteSchema, faqSchema, webApp, datePublished, dateModified, ogImage } = Astro.props;
const canonicalUrl = Astro.url.pathname === "/"
  ? "https://www.chinese-zodiac-calculator.com"
  : `https://www.chinese-zodiac-calculator.com${Astro.url.pathname}`;
const ogImageInput = ogImage || "/og/home.png";
const ogImageUrl = ogImageInput.startsWith("http") ? ogImageInput : `https://www.chinese-zodiac-calculator.com${ogImageInput}`;
const year = new Date().getFullYear();
const lastUpdated = dateModified || "2026-08-19";

const breadcrumbSchema = breadcrumbs?.length ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((bc, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": bc.label,
    "item": `https://www.chinese-zodiac-calculator.com${bc.href}`
  }))
} : null;

const websiteSchemaObj = websiteSchema ? {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "ZodiacCalc",
  "alternateName": "Chinese-Zodiac-Calculator.com",
  "url": "https://www.chinese-zodiac-calculator.com",
  "description": "Free Chinese Zodiac Calculator — Discover your animal sign, element, personality traits, and compatibility."
} : null;

const faqSchemaObj = faqSchema && faqSchema.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqSchema.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
} : null;

const webAppSchemaObj = webApp ? {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "ZodiacCalc — Chinese Zodiac Calculator",
  "alternateName": "Chinese Zodiac Calculator",
  "url": "https://www.chinese-zodiac-calculator.com",
  "applicationCategory": "ReferenceApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "description": "Free Chinese Zodiac Calculator — enter your birth date to find your animal sign, element, personality traits, lucky items, and compatibility.",
  "author": {
    "@type": "Organization",
    "name": "ZodiacCalc Editorial Team",
    "url": "https://www.chinese-zodiac-calculator.com/about/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "ZodiacCalc",
    "url": "https://www.chinese-zodiac-calculator.com"
  },
  "datePublished": datePublished || "2026-01-01",
  "dateModified": lastUpdated
} : null;

const articleSchemaObj = articleSchema ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "url": canonicalUrl,
  "datePublished": datePublished || "2026-01-01",
  "dateModified": lastUpdated,
  "author": {
    "@type": "Person",
    "name": "Chinese-Zodiac-Calculator.com Editorial Team",
    "url": "https://www.chinese-zodiac-calculator.com/about",
  },
  "publisher": {
    "@type": "Organization",
    "name": "Chinese-Zodiac-Calculator.com",
    "url": "https://www.chinese-zodiac-calculator.com",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.chinese-zodiac-calculator.com/logo.svg"
    }
  },
  "image": {
    "@type": "ImageObject",
    "url": ogImageUrl
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
} : null;
---

