    </script>
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>}
    {websiteSchemaObj && <script type="application/ld+json" set:html={JSON.stringify(websiteSchemaObj)}></script>}
    {articleSchemaObj && <script type="application/ld+json" set:html={JSON.stringify(articleSchemaObj)}></script>}
    {faqSchemaObj && <script type="application/ld+json" set:html={JSON.stringify(faqSchemaObj)}></script>}
    {webAppSchemaObj && <script type="application/ld+json" set:html={JSON.stringify(webAppSchemaObj)}></script>}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(Array.isArray(schema) ? schema : [schema])}></script>}
