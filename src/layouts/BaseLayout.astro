    <meta name="twitter:title" content={`${title} | ZodiacCalc`} />
    <meta name="twitter:description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "ZodiacCalc",
        "alternateName": "Chinese-Zodiac-Calculator.com",
        "url": "https://www.chinese-zodiac-calculator.com",
        "logo": "https://www.chinese-zodiac-calculator.com/logo.svg",
