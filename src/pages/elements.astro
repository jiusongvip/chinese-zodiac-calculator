---
import BaseLayout from "../layouts/BaseLayout.astro";


const title = "Chinese Zodiac Elements Guide";
const description =
  "Discover your Chinese zodiac element (Wood, Fire, Earth, Metal, Water) with our calculator and learn how the five elements shape your personality.";
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Elements", href: "/elements" },
];
---

<BaseLayout {title} {description} {breadcrumbs} articleSchema={true}>
  <article class="relative mx-auto max-w-[1000px] px-4 py-10 lg:px-6 lg:py-16">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-transparent via-zodiac-gold/70 to-transparent" aria-hidden="true"></div>
    <!-- Hero -->
    <header class="text-center">
      <div class="mb-6 flex items-center justify-center gap-3">
        <span class="h-px w-10 bg-gradient-to-r from-transparent to-zodiac-gold/70"></span>
        <span class="inline-flex items-center justify-center rounded-[5px] bg-zodiac-red px-2 py-1 text-xs font-bold tracking-widest text-white shadow-md shadow-red-900/20" style="font-family: var(--font-cn)">五行</span>
        <span class="hidden text-[11px] font-semibold uppercase tracking-[0.35em] text-zodiac-gold sm:inline">Wǔxíng</span>
        <span class="h-px w-10 bg-gradient-to-l from-transparent to-zodiac-gold/70"></span>
      </div>
      <h1 class="font-display text-3xl font-bold tracking-tight text-zodiac-ink md:text-4xl dark:text-stone-100">
        Chinese Zodiac <span class="bg-gradient-to-r from-zodiac-deep via-zodiac-red to-zodiac-bronze bg-clip-text pb-1 text-transparent">Elements</span> Calculator
      </h1>
      <p class="mt-3 text-lg text-stone-500 dark:text-stone-400">
        Enter your birth year to discover your element
      </p>
    </header>

    <!-- Calculator -->
    <section class="mx-auto mt-10 max-w-md rounded-2xl border border-zodiac-gold/25 bg-white p-6 shadow-md shadow-red-900/10 dark:border-zodiac-gold/20 dark:bg-stone-800">
      <div class="flex gap-3">
        <input
          id="year-input"
          type="number"
          min="1900"
          max="2030"
          placeholder="e.g. 1990"
          class="min-w-0 flex-1 rounded-lg border border-stone-300 px-4 py-2.5 text-sm text-zodiac-ink outline-none transition focus:border-zodiac-red focus:ring-2 focus:ring-zodiac-red/20 dark:border-stone-600 dark:bg-stone-700 dark:text-stone-100 dark:focus:border-zodiac-red"
        />
        <button
          id="calc-btn"
          class="shrink-0 cursor-pointer rounded-lg bg-zodiac-red px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-red-700 active:scale-[0.97]"
        >
          Find My Element
        </button>
      </div>
      <div id="result" class="mt-5 hidden">
        <div class="rounded-xl border border-zodiac-gold/15 bg-zodiac-cream/60 p-5 dark:border-zodiac-gold/10 dark:bg-stone-700/50">
          <div class="flex items-center gap-3">
            <span id="result-badge" class="inline-block rounded-full px-3.5 py-1 text-sm font-semibold text-white"></span>
            <span class="text-xs text-stone-400 dark:text-stone-500">Element</span>
          </div>
          <p id="result-traits" class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-300"></p>
        </div>
      </div>
      <p id="error-msg" class="mt-3 hidden text-sm text-zodiac-red"></p>
    </section>

    <!-- Five Elements -->
    <section class="mt-16 rounded-2xl bg-zodiac-cream/70 p-6 pb-10 md:p-10 dark:bg-stone-800/50">
      <h2 class="font-display text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">The Five Elements</h2>
      <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">
        Each element governs specific birth years and brings unique personality traits.
      </p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 dark:border-zodiac-gold/15 dark:bg-stone-800">
          <div class="mb-3 h-2 w-full rounded-full" style="background-color:#5B8C5A"></div>
          <h3 class="text-lg font-semibold text-zodiac-ink dark:text-stone-100">Wood</h3>
          <p class="mt-1 text-xs text-stone-400 dark:text-stone-500">Years: 1954, 1955, 1964, 1965, 1974, 1975, 1984, 1985, 1994, 1995, 2004, 2005, 2014, 2015, 2024, 2025</p>
          <p class="mt-3 text-sm text-stone-600 dark:text-stone-300">Creative, generous, and idealistic. Wood people grow steadily like a tree — they thrive when planting new ideas and nurturing others. Their challenge is rigidity: staying flexible lets them bend with the wind instead of breaking.</p>
          <p class="mt-3 text-xs text-stone-500 dark:text-stone-400"><strong class="text-zodiac-ink dark:text-stone-200">Zodiac signs:</strong> <a href="/signs/tiger" class="underline-offset-2 hover:underline">Tiger</a>, <a href="/signs/rabbit" class="underline-offset-2 hover:underline">Rabbit</a></p>
          <div class="mt-3 space-y-1 text-xs text-stone-500 dark:text-stone-400">
            <p><strong class="text-zodiac-ink dark:text-stone-200">Generates:</strong> Fire</p>
            <p><strong class="text-zodiac-ink dark:text-stone-200">Overcomes:</strong> Earth</p>
          </div>
        </div>
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 dark:border-zodiac-gold/15 dark:bg-stone-800">
          <div class="mb-3 h-2 w-full rounded-full" style="background-color:#DC2626"></div>
          <h3 class="text-lg font-semibold text-zodiac-ink dark:text-stone-100">Fire</h3>
          <p class="mt-1 text-xs text-stone-400 dark:text-stone-500">Years: 1956, 1957, 1966, 1967, 1976, 1977, 1986, 1987, 1996, 1997, 2006, 2007, 2016, 2017, 2026, 2027</p>
          <p class="mt-3 text-sm text-stone-600 dark:text-stone-300">Passionate, energetic, and adventurous. Fire people bring warmth and excitement wherever they go, inspiring everyone around them. Their challenge is burnout: channeling their intensity into focus turns sparks into a lasting flame.</p>
          <p class="mt-3 text-xs text-stone-500 dark:text-stone-400"><strong class="text-zodiac-ink dark:text-stone-200">Zodiac signs:</strong> <a href="/signs/snake" class="underline-offset-2 hover:underline">Snake</a>, <a href="/signs/horse" class="underline-offset-2 hover:underline">Horse</a></p>
          <div class="mt-3 space-y-1 text-xs text-stone-500 dark:text-stone-400">
            <p><strong class="text-zodiac-ink dark:text-stone-200">Generates:</strong> Earth</p>
            <p><strong class="text-zodiac-ink dark:text-stone-200">Overcomes:</strong> Metal</p>
          </div>
        </div>
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 dark:border-zodiac-gold/15 dark:bg-stone-800">
          <div class="mb-3 h-2 w-full rounded-full" style="background-color:#C4A46C"></div>
          <h3 class="text-lg font-semibold text-zodiac-ink dark:text-stone-100">Earth</h3>
          <p class="mt-1 text-xs text-stone-400 dark:text-stone-500">Years: 1958, 1959, 1968, 1969, 1978, 1979, 1988, 1989, 1998, 1999, 2008, 2009, 2018, 2019, 2028, 2029</p>
          <p class="mt-3 text-sm text-stone-600 dark:text-stone-300">Practical, stable, and nurturing. Earth people are the reliable foundation others depend on, turning ideas into lasting results. Their challenge is stagnation: welcoming change keeps their steady strength from becoming immovable.</p>
          <p class="mt-3 text-xs text-stone-500 dark:text-stone-400"><strong class="text-zodiac-ink dark:text-stone-200">Zodiac signs:</strong> <a href="/signs/ox" class="underline-offset-2 hover:underline">Ox</a>, <a href="/signs/dragon" class="underline-offset-2 hover:underline">Dragon</a>, <a href="/signs/goat" class="underline-offset-2 hover:underline">Goat</a>, <a href="/signs/dog" class="underline-offset-2 hover:underline">Dog</a></p>
          <div class="mt-3 space-y-1 text-xs text-stone-500 dark:text-stone-400">
            <p><strong class="text-zodiac-ink dark:text-stone-200">Generates:</strong> Metal</p>
            <p><strong class="text-zodiac-ink dark:text-stone-200">Overcomes:</strong> Water</p>
          </div>
        </div>
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 dark:border-zodiac-gold/15 dark:bg-stone-800">
          <div class="mb-3 h-2 w-full rounded-full" style="background-color:#E8D5B7"></div>
          <h3 class="text-lg font-semibold text-zodiac-ink dark:text-stone-100">Metal</h3>
          <p class="mt-1 text-xs text-stone-400 dark:text-stone-500">Years: 1960, 1961, 1970, 1971, 1980, 1981, 1990, 1991, 2000, 2001, 2010, 2011, 2020, 2021</p>
          <p class="mt-3 text-sm text-stone-600 dark:text-stone-300">Strong, determined, and independent. Metal people possess an unyielding will and a sharp intellect that cuts through problems precisely. Their challenge is isolation: softening their edges invites the collaboration that multiplies their strength.</p>
          <p class="mt-3 text-xs text-stone-500 dark:text-stone-400"><strong class="text-zodiac-ink dark:text-stone-200">Zodiac signs:</strong> <a href="/signs/monkey" class="underline-offset-2 hover:underline">Monkey</a>, <a href="/signs/rooster" class="underline-offset-2 hover:underline">Rooster</a></p>
          <div class="mt-3 space-y-1 text-xs text-stone-500 dark:text-stone-400">
            <p><strong class="text-zodiac-ink dark:text-stone-200">Generates:</strong> Water</p>
            <p><strong class="text-zodiac-ink dark:text-stone-200">Overcomes:</strong> Wood</p>
          </div>
        </div>
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 dark:border-zodiac-gold/15 dark:bg-stone-800">
          <div class="mb-3 h-2 w-full rounded-full" style="background-color:#4A90D9"></div>
          <h3 class="text-lg font-semibold text-zodiac-ink dark:text-stone-100">Water</h3>
          <p class="mt-1 text-xs text-stone-400 dark:text-stone-500">Years: 1952, 1953, 1962, 1963, 1972, 1973, 1982, 1983, 1992, 1993, 2002, 2003, 2012, 2013, 2022, 2023</p>
          <p class="mt-3 text-sm text-stone-600 dark:text-stone-300">Intuitive, flexible, and persuasive. Water people adapt effortlessly and understand others deeply, flowing around obstacles with ease. Their challenge is direction: committing to clear goals channels their depth into decisive action.</p>
          <p class="mt-3 text-xs text-stone-500 dark:text-stone-400"><strong class="text-zodiac-ink dark:text-stone-200">Zodiac signs:</strong> <a href="/signs/rat" class="underline-offset-2 hover:underline">Rat</a>, <a href="/signs/pig" class="underline-offset-2 hover:underline">Pig</a></p>
          <div class="mt-3 space-y-1 text-xs text-stone-500 dark:text-stone-400">
            <p><strong class="text-zodiac-ink dark:text-stone-200">Generates:</strong> Wood</p>
            <p><strong class="text-zodiac-ink dark:text-stone-200">Overcomes:</strong> Fire</p>
          </div>
        </div>
      </div>
    </section>
    <!-- Element Cycle Diagram -->
    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">Element Cycles</h2>
      <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">
        The five elements interact through two fundamental cycles.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-6 shadow-md shadow-red-900/10 dark:border-zodiac-gold/15 dark:bg-stone-800">
          <h3 class="flex items-center gap-2 text-lg font-semibold text-zodiac-ink dark:text-stone-100">
            <span class="inline-block h-3 w-3 rounded-full bg-green-500"></span>
            Generating Cycle
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
            Also called the <strong>Creative Cycle</strong>, each element nourishes and creates the next:
          </p>
          <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-sm font-medium">
            <span class="rounded-lg bg-green-100 px-3 py-1.5 text-green-800 dark:bg-green-900/40 dark:text-green-300">Wood</span>
            <span class="text-stone-400">&#8594;</span>
            <span class="rounded-lg bg-red-100 px-3 py-1.5 text-red-800 dark:bg-red-900/40 dark:text-red-300">Fire</span>
            <span class="text-stone-400">&#8594;</span>
            <span class="rounded-lg bg-amber-100 px-3 py-1.5 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">Earth</span>
            <span class="text-stone-400">&#8594;</span>
            <span class="rounded-lg bg-stone-200 px-3 py-1.5 text-stone-800 dark:bg-stone-600 dark:text-stone-200">Metal</span>
            <span class="text-stone-400">&#8594;</span>
            <span class="rounded-lg bg-blue-100 px-3 py-1.5 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">Water</span>
            <span class="text-stone-400">&#8594;</span>
            <span class="rounded-lg bg-green-100 px-3 py-1.5 text-green-800 dark:bg-green-900/40 dark:text-green-300">Wood</span>
          </div>
          <p class="mt-3 text-xs text-stone-400 dark:text-stone-500">
            Wood fuels Fire &#183; Fire creates ash (Earth) &#183; Earth bears Metal &#183; Metal melts to liquid (Water) &#183; Water nourishes Wood
          </p>
        </div>
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-6 shadow-md shadow-red-900/10 dark:border-zodiac-gold/15 dark:bg-stone-800">
          <h3 class="flex items-center gap-2 text-lg font-semibold text-zodiac-ink dark:text-stone-100">
            <span class="inline-block h-3 w-3 rounded-full bg-red-500"></span>
            Overcoming Cycle
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-300">
            Also called the <strong>Destructive Cycle</strong>, each element controls or restrains another:
          </p>
          <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-sm font-medium">
            <span class="rounded-lg bg-green-100 px-3 py-1.5 text-green-800 dark:bg-green-900/40 dark:text-green-300">Wood</span>
            <span class="text-stone-400">&#8594;</span>
            <span class="rounded-lg bg-amber-100 px-3 py-1.5 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">Earth</span>
            <span class="text-stone-400">&#8594;</span>
            <span class="rounded-lg bg-blue-100 px-3 py-1.5 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">Water</span>
            <span class="text-stone-400">&#8594;</span>
            <span class="rounded-lg bg-red-100 px-3 py-1.5 text-red-800 dark:bg-red-900/40 dark:text-red-300">Fire</span>
            <span class="text-stone-400">&#8594;</span>
            <span class="rounded-lg bg-stone-200 px-3 py-1.5 text-stone-800 dark:bg-stone-600 dark:text-stone-200">Metal</span>
            <span class="text-stone-400">&#8594;</span>
            <span class="rounded-lg bg-green-100 px-3 py-1.5 text-green-800 dark:bg-green-900/40 dark:text-green-300">Wood</span>
          </div>
          <p class="mt-3 text-xs text-stone-400 dark:text-stone-500">
            Wood consumes Earth &#183; Earth absorbs Water &#183; Water extinguishes Fire &#183; Fire melts Metal &#183; Metal chops Wood
          </p>
        </div>
      </div>
    </section>
    <!-- FAQ -->
    <section class="mt-16">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">Frequently Asked Questions</h2>

      <div class="mt-8 space-y-4">
        <details class="group rounded-xl border border-zodiac-gold/25 bg-white transition open:border-zodiac-red/40 dark:border-zodiac-gold/15 dark:bg-stone-800 dark:open:border-zodiac-red/40">
          <summary class="flex cursor-pointer items-center justify-between px-5 py-4 text-sm font-medium text-zodiac-ink dark:text-stone-100 [&::-webkit-details-marker]:hidden">
            What are the five Chinese zodiac elements?
            <svg class="h-4 w-4 shrink-0 text-stone-400 transition group-open:rotate-180" viewBox="0 0 16 16" fill="none"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </summary>
          <div class="border-t border-zodiac-gold/15 px-5 pb-4 pt-3 dark:border-zodiac-gold/10">
            <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              The five elements are <strong>Wood, Fire, Earth, Metal, and Water</strong>. They form the foundation of Chinese metaphysics and cycle through a 10-year repeating pattern. Each element is associated with specific birth years and influences personality, relationships, and destiny.
            </p>
          </div>
        </details>

        <details class="group rounded-xl border border-zodiac-gold/25 bg-white transition open:border-zodiac-red/40 dark:border-zodiac-gold/15 dark:bg-stone-800 dark:open:border-zodiac-red/40">
          <summary class="flex cursor-pointer items-center justify-between px-5 py-4 text-sm font-medium text-zodiac-ink dark:text-stone-100 [&::-webkit-details-marker]:hidden">
            How do I calculate my Chinese zodiac element?
            <svg class="h-4 w-4 shrink-0 text-stone-400 transition group-open:rotate-180" viewBox="0 0 16 16" fill="none"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </summary>
          <div class="border-t border-zodiac-gold/15 px-5 pb-4 pt-3 dark:border-zodiac-gold/10">
            <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              Your element is determined by the last digit of your birth year. The Heavenly Stem cycle assigns elements in pairs: years ending in 4 or 5 are Wood, 6 or 7 are Fire, 8 or 9 are Earth, 0 or 1 are Metal, and 2 or 3 are Water. Use the calculator above to find yours instantly.
            </p>
          </div>
        </details>

        <details class="group rounded-xl border border-zodiac-gold/25 bg-white transition open:border-zodiac-red/40 dark:border-zodiac-gold/15 dark:bg-stone-800 dark:open:border-zodiac-red/40">
          <summary class="flex cursor-pointer items-center justify-between px-5 py-4 text-sm font-medium text-zodiac-ink dark:text-stone-100 [&::-webkit-details-marker]:hidden">
            What does the Generating Cycle mean?
            <svg class="h-4 w-4 shrink-0 text-stone-400 transition group-open:rotate-180" viewBox="0 0 16 16" fill="none"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </summary>
          <div class="border-t border-zodiac-gold/15 px-5 pb-4 pt-3 dark:border-zodiac-gold/10">
            <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              The Generating Cycle (Sheng Cycle) describes how each element nourishes and creates the next one: Wood feeds Fire, Fire creates Earth (ash), Earth bears Metal, Metal carries Water, and Water nourishes Wood. This cycle represents support, growth, and harmonious relationships between elements.
            </p>
          </div>
        </details>

        <details class="group rounded-xl border border-zodiac-gold/25 bg-white transition open:border-zodiac-red/40 dark:border-zodiac-gold/15 dark:bg-stone-800 dark:open:border-zodiac-red/40">
          <summary class="flex cursor-pointer items-center justify-between px-5 py-4 text-sm font-medium text-zodiac-ink dark:text-stone-100 [&::-webkit-details-marker]:hidden">
            What does the Overcoming Cycle mean?
            <svg class="h-4 w-4 shrink-0 text-stone-400 transition group-open:rotate-180" viewBox="0 0 16 16" fill="none"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </summary>
          <div class="border-t border-zodiac-gold/15 px-5 pb-4 pt-3 dark:border-zodiac-gold/10">
            <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              The Overcoming Cycle (Ke Cycle) describes how each element controls another: Wood consumes Earth, Earth absorbs Water, Water extinguishes Fire, Fire melts Metal, and Metal chops Wood. This cycle represents checks and balances that maintain harmony in nature and in human relationships.
            </p>
          </div>
        </details>

        <details class="group rounded-xl border border-zodiac-gold/25 bg-white transition open:border-zodiac-red/40 dark:border-zodiac-gold/15 dark:bg-stone-800 dark:open:border-zodiac-red/40">
          <summary class="flex cursor-pointer items-center justify-between px-5 py-4 text-sm font-medium text-zodiac-ink dark:text-stone-100 [&::-webkit-details-marker]:hidden">
            Does my element change with each Chinese New Year?
            <svg class="h-4 w-4 shrink-0 text-stone-400 transition group-open:rotate-180" viewBox="0 0 16 16" fill="none"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </summary>
          <div class="border-t border-zodiac-gold/15 px-5 pb-4 pt-3 dark:border-zodiac-gold/10">
            <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              Your birth element is fixed for life. While yearly elements change with the Chinese calendar and may influence your annual fortune, the element assigned to your birth year stays with you permanently and represents your core personality traits.
            </p>
          </div>
        </details>

        <details class="group rounded-xl border border-zodiac-gold/25 bg-white transition open:border-zodiac-red/40 dark:border-zodiac-gold/15 dark:bg-stone-800 dark:open:border-zodiac-red/40">
          <summary class="flex cursor-pointer items-center justify-between px-5 py-4 text-sm font-medium text-zodiac-ink dark:text-stone-100 [&::-webkit-details-marker]:hidden">
            Can two people with conflicting elements get along?
            <svg class="h-4 w-4 shrink-0 text-stone-400 transition group-open:rotate-180" viewBox="0 0 16 16" fill="none"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </summary>
          <div class="border-t border-zodiac-gold/15 px-5 pb-4 pt-3 dark:border-zodiac-gold/10">
            <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-300">
              Absolutely. While traditional Chinese metaphysics suggests that certain element combinations face more friction, all relationships require understanding and compromise. The Overcoming Cycle actually shows how elements balance each other out &#8212; differences can lead to growth when both parties respect each other&#8217;s strengths.
            </p>
          </div>
        </details>
      </div>
    </section>
  </article>
  <script is:inline>
    (function () {
      var input = document.getElementById("year-input");
      var btn = document.getElementById("calc-btn");
      var result = document.getElementById("result");
      var badge = document.getElementById("result-badge");
      var traits = document.getElementById("result-traits");
      var error = document.getElementById("error-msg");

      var elements = {
        Wood: { color: "#5B8C5A", desc: "Wood: Creative, generous, and idealistic. You are a natural leader who values growth, harmony, and nurturing others. You thrive when you can plant new ideas and watch them grow." },
        Fire: { color: "#DC2626", desc: "Fire: Passionate, energetic, and adventurous. You bring warmth and excitement to every situation. Your enthusiasm is contagious, but you benefit from learning patience and moderation." },
        Earth: { color: "#C4A46C", desc: "Earth: Practical, stable, and nurturing. You are the reliable foundation that others depend on. Your grounded nature brings security, and you excel at turning ideas into lasting results." },
        Metal: { color: "#E8D5B7", desc: "Metal: Strong, determined, and independent. You have an unyielding will and sharp intellect. Your discipline and focus help you achieve great things, but remember to stay flexible." },
        Water: { color: "#4A90D9", desc: "Water: Intuitive, flexible, and persuasive. You adapt effortlessly and understand others on a deep level. Your emotional intelligence is your superpower, and you flow around obstacles with ease." },
      };

      function getElementKey(year) {
        var stemIndex = (year - 4) % 10;
        if (stemIndex < 0) stemIndex += 10;
        return ["Wood", "Wood", "Fire", "Fire", "Earth", "Earth", "Metal", "Metal", "Water", "Water"][stemIndex];
      }

      function calculate() {
        error.classList.add("hidden");
        var val = input.value.trim();
        if (!val) {
          error.textContent = "Please enter a birth year.";
          error.classList.remove("hidden");
          result.classList.add("hidden");
          return;
        }
        var year = parseInt(val, 10);
        if (isNaN(year) || year < 1900 || year > 2030) {
          error.textContent = "Please enter a valid year between 1900 and 2030.";
          error.classList.remove("hidden");
          result.classList.add("hidden");
          return;
        }
        var key = getElementKey(year);
        var info = elements[key];
        badge.textContent = key;
        badge.style.backgroundColor = info.color;
        traits.textContent = info.desc;
        result.classList.remove("hidden");
      }

      btn.addEventListener("click", calculate);
      input.addEventListener("keydown", function (e) {
        if (e.key === "Enter") calculate();
      });
    })();
  </script>
</BaseLayout>
