    1933:[1,26],1932:[2,6],1931:[2,17],1930:[1,30],1929:[2,10],1928:[1,23],
    1927:[2,2],1926:[2,13],1925:[1,24],1924:[2,5],1923:[2,16],1922:[2,18],
    1921:[2,8],1920:[2,20],1919:[2,1],1918:[2,11],1917:[1,23],1916:[2,3],
    1915:[2,14],1914:[1,26],1913:[2,6],1912:[2,18],1911:[1,30],1910:[2,10],
    1909:[1,22],1908:[2,2],1907:[2,13],1906:[1,25],1905:[2,4],1904:[2,16],
    1903:[1,29],1902:[2,8],1901:[2,19],1900:[1,31],
  };

  function capitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

  function getAnimalIndex(year, month, day) {
    var idx = (year - 4) % 12;
    if (idx < 0) idx += 12;
    if (lunarDates[year]) {
      var ld = lunarDates[year];
      if (month < ld[0] || (month === ld[0] && day < ld[1])) {
        idx = (idx - 1 + 12) % 12;
      }
    }
    return idx;
  }

  function getElementKey(year) {
    var stemIndex = (year - 4) % 10;
    if (stemIndex < 0) stemIndex += 10;
    return ["Wood","Wood","Fire","Fire","Earth","Earth","Metal","Metal","Water","Water"][stemIndex];
  }

  function getActiveMode() {
    return document.querySelector(".calc-tab[aria-selected='true']")?.getAttribute("data-mode") || "year";
  }

  // ---- Render Result ----
  function calculate() {
    var mode = getActiveMode();
    var month, day, year;
    if (mode === "year") {
      year = parseInt(document.getElementById("calc-year-only").value, 10);
      month = 7; day = 1;
    } else {
      month = parseInt(document.getElementById("calc-month").value, 10);
      day = parseInt(document.getElementById("calc-day").value, 10);
      year = parseInt(document.getElementById("calc-year").value, 10);
    }

    var idx = getAnimalIndex(year, month, day);
    var animal = ANIMALS[idx];
    var element = getElementKey(year);
    var lucky = LUCKY[animal.id];
    var compat = COMPAT_MAP[animal.id];
    var pinyin = PINYIN[animal.id];
    var tags = TRAIT_TAGS[animal.id];

    // Icon
    document.getElementById("result-icon").textContent = EMOJI[animal.id] + " " + ANIMALS[idx].chinese.split(" ")[1];

    // Name + Pinyin
    document.getElementById("result-name").textContent = capitalize(animal.id);
    document.getElementById("result-pinyin").textContent = pinyin;

    // Element
    document.getElementById("result-element").innerHTML =
      '<svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M4 7L6 9L10 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg> Element: ' + element;

    // YinYang
    document.getElementById("result-yinyang").innerHTML =
      '<svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M7 1V3M7 11V13M1 7H3M11 7H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg> ' + animal.yinYang;

    // Rank
    document.getElementById("result-rank").innerHTML =
      '<svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M4 4L10 10M10 4L4 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg> #' + RANK[animal.id];

    // Trait tags
    var tagsEl = document.getElementById("result-tags");
    tagsEl.innerHTML = "";
    tags.forEach(function(t) {
      var span = document.createElement("span");
      span.className = "rounded-full bg-zodiac-red/10 px-3 py-1 text-xs font-medium text-zodiac-red";
      span.textContent = t;
      tagsEl.appendChild(span);
    });

    // Lucky numbers
    var numEl = document.getElementById("result-numbers");
    numEl.innerHTML = "";
    lucky.numbers.forEach(function(n) {
      var span = document.createElement("span");
      span.className = "inline-flex h-9 w-9 items-center justify-center rounded-full bg-zodiac-red text-sm font-bold text-white";
      span.textContent = n;
      numEl.appendChild(span);
    });

    // Lucky colors
    var colEl = document.getElementById("result-colors");
    colEl.innerHTML = "";
    lucky.colors.forEach(function(c) {
      var span = document.createElement("span");
      span.className = "rounded-md bg-zodiac-gold/15 px-3 py-1.5 text-xs font-medium text-zodiac-bronze dark:bg-zodiac-gold/10 dark:text-amber-400";
      span.textContent = c;
      colEl.appendChild(span);
    });

    // Lucky flowers
    var floEl = document.getElementById("result-flowers");
    floEl.innerHTML = "";
    lucky.flowers.forEach(function(f) {
      var span = document.createElement("span");
      span.className = "rounded-md bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-700 dark:bg-amber-900/20 dark:text-amber-400";
      span.textContent = f;
      floEl.appendChild(span);
    });

    // Best matches
    var bestEl = document.getElementById("result-best");
    bestEl.innerHTML = "";
    compat.best.forEach(function(b) {
      var a = document.createElement("a");
      a.href = "/signs/" + b;
      a.className = "inline-flex items-center gap-1 rounded-full bg-zodiac-gold/15 px-3 py-1 text-xs font-medium text-zodiac-bronze no-underline transition-colors hover:bg-zodiac-gold/25 dark:bg-zodiac-gold/10 dark:text-amber-400 dark:hover:bg-zodiac-gold/20";
      a.innerHTML = EMOJI[b] + " " + capitalize(b);
      bestEl.appendChild(a);
    });

    // Worst matches
    var worstEl = document.getElementById("result-worst");
    worstEl.innerHTML = "";
    compat.worst.forEach(function(w) {
      var a = document.createElement("a");
      a.href = "/signs/" + w;
      a.className = "inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-medium text-red-700 no-underline transition-colors hover:bg-red-100 dark:bg-red-900/20 dark:text-red-400 dark:hover:bg-red-900/30";
      a.innerHTML = EMOJI[w] + " " + capitalize(w);
      worstEl.appendChild(a);
    });

    // CTAs
    var ctaEl = document.getElementById("result-ctas");
    ctaEl.innerHTML =
      '<a href="/signs/' + animal.id + '" class="inline-flex items-center gap-1 rounded-lg bg-zodiac-red px-5 py-2.5 text-sm font-semibold text-white transition-all hover:bg-red-700 hover:shadow-md active:scale-[0.97]">Read Full Profile &rarr;</a>' +
      '<a href="/compatibility" class="inline-flex items-center gap-1 rounded-lg border border-zodiac-red px-5 py-2.5 text-sm font-semibold text-zodiac-red transition-all hover:bg-red-50 hover:shadow-sm active:scale-[0.97] dark:hover:bg-red-900/20">Check Compatibility &rarr;</a>' +
      '<a href="/yearly-horoscope" class="inline-flex items-center gap-1 rounded-lg border border-zodiac-gold/25 px-5 py-2.5 text-sm font-semibold text-zodiac-bronze transition-all hover:bg-zodiac-gold/10 hover:shadow-sm active:scale-[0.97] dark:border-zodiac-gold/15 dark:text-amber-400 dark:hover:bg-zodiac-gold/10">2026 Horoscope &rarr;</a>';

    // Show with animation reset
    var section = document.getElementById("result-section");
    section.classList.remove("hidden");
    var card = document.getElementById("result-card");
    // Re-trigger animations by resetting the card
    card.style.animation = "none";
    card.offsetHeight; // force reflow
    card.style.animation = "";

    section.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  // ---- Tab Switching ----
  function switchTab(mode) {
    document.querySelectorAll(".calc-tab").forEach(function(t) {
      t.setAttribute("aria-selected", "false");
      t.className = t.className.replace("bg-zodiac-red text-white shadow-sm", "");
      t.className = t.className.replace(/text-white/g, "");
      t.className = t.className.trim() + " text-stone-600 dark:text-stone-400";
    });
    var activeTab = document.querySelector(".calc-tab[data-mode='" + mode + "']");
    activeTab.setAttribute("aria-selected", "true");
    activeTab.className = activeTab.className.replace("text-stone-600 dark:text-stone-400", "bg-zodiac-red text-white shadow-sm");

    document.getElementById("input-year").classList.toggle("hidden", mode !== "year");
    document.getElementById("input-date").classList.toggle("hidden", mode !== "date");
  }

  // ---- Bind ----
  document.addEventListener("DOMContentLoaded", function() {
    // Tabs
    document.querySelectorAll(".calc-tab").forEach(function(tab) {
      tab.addEventListener("click", function() {
        switchTab(this.getAttribute("data-mode"));
      });
    });

    // Calculate button
    document.getElementById("calc-btn").addEventListener("click", calculate);

    // Enter key support on inputs
    var inputs = ["calc-year-only", "calc-month", "calc-day", "calc-year"];
    inputs.forEach(function(id) {
      var el = document.getElementById(id);
      if (el) {
        el.addEventListener("keydown", function(e) {
          if (e.key === "Enter") calculate();
        });
      }
    });

    // Allow Enter on year input
    document.getElementById("calc-year-only").addEventListener("keydown", function(e) {
      if (e.key === "Enter") calculate();
    });
  });
})();
</script>
