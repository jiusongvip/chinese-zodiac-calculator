---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ZODIAC_ANIMALS, ZODIAC_YEARS, LUCKY_THINGS, COMPATIBILITY, ZODIAC_LUNAR_RANGES, HOROSCOPES_2026 } from "../data/zodiac";
import CompatibilityMatrix from "../components/CompatibilityMatrix.astro";

const animals = ZODIAC_ANIMALS;
const currentYear = new Date().getFullYear();
const minYear = 1900;
const maxYear = 2035;
const yearList = Array.from({ length: maxYear - minYear + 1 }, (_, i) => maxYear - i);
const days = Array.from({ length: 31 }, (_, i) => i + 1);
const months = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];
const monthAbbr = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];

const zodiacYears = ZODIAC_YEARS;
const compatData = COMPATIBILITY;
const lunarRanges = ZODIAC_LUNAR_RANGES;
const horoscopes2026 = HOROSCOPES_2026;

const faqs = [
  { q: "What is the Chinese zodiac?", a: "The Chinese zodiac (生肖, shēngxiào) is a 12-year cycle where each year is represented by an animal. Based on the lunar calendar, it has been used for centuries in Chinese culture to interpret personality, predict fortune, and determine compatibility. Unlike the Western zodiac which follows monthly dates, the Chinese zodiac follows lunar years." },
  { q: "How do I find my Chinese zodiac sign?", a: "Simply enter your birth date into the calculator above. It will determine your animal sign based on the lunar new year calendar. Using only the year can be about 10% inaccurate for people born in January or February — our full birth date calculator handles this automatically using accurate Chinese New Year dates from 1900 to 2035." },
  { q: "What are the 12 Chinese zodiac animals in order?", a: "The 12 animals in order are: Rat (#1), Ox (#2), Tiger (#3), Rabbit (#4), Dragon (#5), Snake (#6), Horse (#7), Goat (#8), Monkey (#9), Rooster (#10), Dog (#11), and Pig (#12). Each animal has unique personality traits, elemental associations, and compatibility patterns. The Dragon is the only mythical creature in the cycle." },
  { q: "What is the difference between zodiac sign and element?", a: "Your zodiac sign is determined by the 12-year animal cycle (what year you were born). Your element — Wood, Fire, Earth, Metal, or Water — follows a separate 10-year Heavenly Stem cycle. Together, your animal and element create a more detailed personality profile. For example, a Wood Rat differs from a Fire Rat, though both share core Rat traits. Use our <a href=\"/elements\" class=\"font-medium text-zodiac-red underline-offset-2 hover:underline\">Elements Calculator</a> to learn more." },
  { q: "Which zodiac signs are most compatible?", a: "Best matches are usually signs four years apart in the zodiac cycle. Classic pairings include Rat with Dragon and Monkey, Ox with Snake and Rooster, Tiger with Horse and Dog, and Rabbit with Goat and Pig. Use our <a href=\"/compatibility\" class=\"font-medium text-zodiac-red underline-offset-2 hover:underline\">Compatibility Calculator</a> to check any two signs, or browse the compatibility matrix above." },
  { q: "When does Chinese New Year 2026 start?", a: "The 2026 Chinese New Year begins on <strong>February 17, 2026</strong>, marking the start of the Year of the Fire Horse. Anyone born on or after this date belongs to the Horse sign. Those born earlier in 2026 (Jan 1 – Feb 16) are still Snakes. Check our <a href=\"/year-chart\" class=\"font-medium text-zodiac-red underline-offset-2 hover:underline\">Year Chart</a> for a complete reference of all 12 signs." },
  { q: "Does the zodiac sign change at Lichun or Lunar New Year?", a: "There are two conventions. The mainstream method (used by this calculator and by most Chinese astrology guides) changes the sign on the Lunar New Year (the first day of the Chinese calendar). A smaller school of thought uses Lichun (Start of Spring, around February 4), the first of the 24 solar terms, as the boundary. The difference only affects people born between approximately February 4 and the Lunar New Year date. If you were born in this window, your sign depends on which convention you follow — most modern interpretations use the Lunar New Year." },
];

const newYearDates = [
  { year: 2020, date: "Jan 25", animal: "Rat" },
  { year: 2021, date: "Feb 12", animal: "Ox" },
  { year: 2022, date: "Feb 1", animal: "Tiger" },
  { year: 2023, date: "Jan 22", animal: "Rabbit" },
  { year: 2024, date: "Feb 10", animal: "Dragon" },
  { year: 2025, date: "Jan 29", animal: "Snake" },
  { year: 2026, date: "Feb 17", animal: "Horse" },
  { year: 2027, date: "Feb 6", animal: "Goat" },
  { year: 2028, date: "Jan 26", animal: "Monkey" },
  { year: 2029, date: "Feb 13", animal: "Rooster" },
  { year: 2030, date: "Feb 3", animal: "Dog" },
  { year: 2031, date: "Jan 23", animal: "Pig" },
  { year: 2032, date: "Feb 11", animal: "Rat" },
  { year: 2033, date: "Jan 31", animal: "Ox" },
  { year: 2034, date: "Feb 19", animal: "Tiger" },
  { year: 2035, date: "Feb 8", animal: "Rabbit" },
];

function capitalize(s: string) {
  return s.charAt(0).toUpperCase() + s.slice(1);
}
---

<BaseLayout
  title="Chinese Zodiac Calculator - Sign Guide"
  description="Free Chinese Zodiac Calculator. Enter your birth date to find your animal sign, element, and lucky items. Accurate lunar calendar results from 1900 to 2035."
  breadcrumbs={[{ label: "Home", href: "/" }]}
  websiteSchema={true}
  webApp={true}
  faqSchema={faqs}
  ogImage="/og/home.png"
  dateModified="2026-08-19"
>
  <!-- ===== HERO CALCULATOR ===== -->
  <section class="relative overflow-hidden bg-zodiac-cream px-4 pb-16 pt-14 dark:bg-stone-950 sm:pt-16">
    <!-- 装饰层：顶部金线 + 光晕 + 汉字水印 + 底部回纹 -->
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-transparent via-zodiac-gold/70 to-transparent"></div>
      <div class="absolute -left-44 -top-44 h-[30rem] w-[30rem] rounded-full bg-zodiac-red/10 blur-3xl dark:bg-zodiac-red/10"></div>
      <div class="absolute -bottom-52 -right-52 h-[34rem] w-[34rem] rounded-full bg-zodiac-gold/15 blur-3xl dark:bg-zodiac-gold/10"></div>
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 select-none opacity-[0.05] dark:opacity-[0.04]" style="font-family: var(--font-cn)">
        <span class="text-[20rem] font-black leading-none tracking-tight text-zodiac-red sm:text-[26rem]">生肖</span>
      </div>
      <svg class="absolute bottom-0 left-1/2 h-6 w-[420px] max-w-full -translate-x-1/2 text-zodiac-gold/25" viewBox="0 0 420 24" fill="none">
        <path d="M0 12h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h10v-10h10v10h20" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </div>

    <div class="relative mx-auto max-w-[880px] text-center">
      <!-- Eyebrow：印章 + 生肖 -->
      <p class="mb-6 flex items-center justify-center gap-3 text-[11px] font-semibold uppercase tracking-[0.35em] text-zodiac-gold">
        <span class="h-px w-10 bg-gradient-to-r from-transparent to-zodiac-gold/70"></span>
        <span class="inline-flex items-center justify-center rounded-[5px] bg-zodiac-red px-2 py-1 text-xs font-bold tracking-widest text-white shadow-md shadow-red-900/20" style="font-family: var(--font-cn)">生肖</span>
        <span class="hidden sm:inline">Shengxiao</span>
        <span class="h-px w-10 bg-gradient-to-l from-transparent to-zodiac-gold/70"></span>
      </p>

      <h1 class="font-display text-5xl font-bold leading-[1.05] tracking-tight text-zodiac-ink dark:text-stone-100 sm:text-[4.25rem]">
        Chinese Zodiac
        <span class="block bg-gradient-to-r from-zodiac-deep via-zodiac-red to-zodiac-bronze bg-clip-text pb-1 text-transparent">Calculator</span>
      </h1>
      <p class="mx-auto mt-6 max-w-[560px] text-lg leading-relaxed text-stone-600 dark:text-stone-400">
        Enter your birth date to discover your animal sign, element, personality traits, and lucky items.
      </p>

      <!-- 计算器：红金渐变描边卡片 -->
      <div class="relative mx-auto mt-10 max-w-[560px]">
        <div class="rounded-3xl bg-gradient-to-br from-zodiac-gold/50 via-zodiac-red/25 to-zodiac-gold/50 p-[1.5px] shadow-xl shadow-red-900/10 dark:shadow-black/40">
          <div class="rounded-[calc(1.5rem-1.5px)] bg-white p-6 dark:bg-stone-900 sm:p-7">
            <!-- Tabs -->
            <div class="mb-6 flex rounded-xl border border-zodiac-gold/25 bg-zodiac-cream p-1 dark:border-stone-700 dark:bg-stone-800" role="tablist">
              <button id="tab-year" class="calc-tab flex-1 cursor-pointer rounded-lg px-4 py-2 text-sm font-semibold text-white bg-zodiac-red shadow-sm transition-all" role="tab" aria-selected="true" data-mode="year">By Year</button>
              <button id="tab-date" class="calc-tab flex-1 cursor-pointer rounded-lg px-4 py-2 text-sm font-semibold text-stone-600 transition-all hover:text-zodiac-red dark:text-stone-400 dark:hover:text-zodiac-red" role="tab" aria-selected="false" data-mode="date">By Birth Date</button>
            </div>

            <!-- Year Mode Input -->
            <div id="input-year" class="calc-input">
              <label for="calc-year-only" class="mb-2 block text-left text-sm font-medium text-stone-700 dark:text-stone-300">Enter your birth year:</label>
              <input id="calc-year-only" type="number" value={currentYear - 20} min={minYear} max={maxYear}
                class="w-full rounded-lg border border-zodiac-gold/25 bg-zodiac-cream/50 px-4 py-2.5 text-center text-lg font-semibold focus:border-zodiac-red focus:outline-none focus:ring-2 focus:ring-red-200 dark:border-stone-600 dark:bg-stone-800 dark:text-stone-200" />
            </div>

            <!-- Date Mode Input -->
            <div id="input-date" class="calc-input hidden">
              <div class="grid gap-4 sm:grid-cols-3">
                <div>
                  <label for="calc-month" class="mb-1 block text-left text-sm font-medium text-stone-700 dark:text-stone-300">Month</label>
                  <select id="calc-month" class="w-full rounded-lg border border-zodiac-gold/25 bg-zodiac-cream/50 px-3 py-2.5 text-sm focus:border-zodiac-red focus:outline-none focus:ring-2 focus:ring-red-200 dark:border-stone-600 dark:bg-stone-800 dark:text-stone-200">
                    {months.map((m, i) => (
                      <option value={i + 1}>{m}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label for="calc-day" class="mb-1 block text-left text-sm font-medium text-stone-700 dark:text-stone-300">Day</label>
                  <select id="calc-day" class="w-full rounded-lg border border-zodiac-gold/25 bg-zodiac-cream/50 px-3 py-2.5 text-sm focus:border-zodiac-red focus:outline-none focus:ring-2 focus:ring-red-200 dark:border-stone-600 dark:bg-stone-800 dark:text-stone-200">
                    {days.map((d) => (
                      <option value={d}>{d}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label for="calc-year" class="mb-1 block text-left text-sm font-medium text-stone-700 dark:text-stone-300">Year</label>
                  <select id="calc-year" class="w-full rounded-lg border border-zodiac-gold/25 bg-zodiac-cream/50 px-3 py-2.5 text-sm focus:border-zodiac-red focus:outline-none focus:ring-2 focus:ring-red-200 dark:border-stone-600 dark:bg-stone-800 dark:text-stone-200">
                    {yearList.map((y) => (
                      <option value={y} selected={y === currentYear - 20}>{y}</option>
                    ))}
                  </select>
                </div>
              </div>
              <p class="mt-3 text-left text-xs text-stone-400 dark:text-stone-500">
                People born before Chinese New Year belong to the previous year's sign.
              </p>
            </div>

            <button id="calc-btn" class="mt-5 w-full cursor-pointer rounded-xl bg-gradient-to-r from-zodiac-deep via-zodiac-red to-zodiac-deep px-6 py-3.5 text-base font-semibold text-white shadow-lg shadow-red-900/25 transition-all hover:shadow-xl hover:brightness-110 active:scale-[0.97]">
              Find My Zodiac &rarr;
            </button>
          </div>
        </div>
      </div>

      <!-- 12 生肖汉字圆章带 -->
      <div class="mx-auto mt-12 max-w-[780px]">
        <div class="grid grid-cols-6 gap-x-2 gap-y-6 sm:grid-cols-12">
          {animals.map((a) => (
            <a href={`/signs/${a.id}`} class="group flex flex-col items-center gap-1.5 no-underline">
              <span class="flex h-11 w-11 items-center justify-center rounded-full border-[1.5px] border-zodiac-gold/40 bg-white/85 text-lg font-bold text-zodiac-ink shadow-sm transition-all duration-300 group-hover:-translate-y-1 group-hover:border-zodiac-red group-hover:bg-zodiac-red group-hover:text-white group-hover:shadow-md dark:border-zodiac-gold/30 dark:bg-stone-800 dark:text-stone-200 dark:group-hover:border-zodiac-red dark:group-hover:bg-zodiac-red dark:group-hover:text-white" style="font-family: var(--font-cn)">
                {a.chinese}
              </span>
              <span class="text-[10px] font-medium uppercase tracking-wider text-stone-500 transition-colors group-hover:text-zodiac-red dark:text-stone-400">{a.id}</span>
            </a>
          ))}
        </div>
        <p class="mt-5 text-center text-[11px] tracking-wide text-stone-400 dark:text-stone-500">Click any sign to explore its full personality profile</p>
      </div>
    </div>
  </section>

  <!-- ===== RESULT SECTION ===== -->
  <section id="result-section" class="px-4 py-12 hidden">
    <div class="mx-auto max-w-[800px]">
      <div id="result-card" class="result-card relative overflow-hidden rounded-2xl border border-zodiac-gold/30 bg-white p-6 shadow-xl shadow-red-900/10 dark:border-zodiac-gold/20 dark:bg-stone-900 sm:p-10">
        <div class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-zodiac-deep via-zodiac-red to-zodiac-bronze" aria-hidden="true"></div>
        <div class="flex flex-col items-center text-center sm:flex-row sm:items-start sm:text-left sm:gap-8">
          <div id="result-icon" class="mb-4 sm:mb-0 flex h-32 w-32 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-zodiac-cream to-amber-50 text-6xl ring-2 ring-zodiac-gold/40 dark:from-stone-800 dark:to-stone-800 dark:ring-zodiac-gold/30"></div>
          <div class="flex-1">
            <div class="mb-1 stagger-1">
              <h2 class="text-3xl font-bold tracking-tight text-zodiac-ink dark:text-stone-100" id="result-name"></h2>
              <p class="text-base text-stone-400" id="result-pinyin"></p>
            </div>
            <div class="mt-3 flex flex-wrap items-center justify-center gap-2 sm:justify-start stagger-2">
              <span id="result-element" class="inline-flex items-center gap-1.5 rounded-full bg-zodiac-red/10 px-3.5 py-1.5 text-sm font-medium text-zodiac-red"></span>
              <span id="result-yinyang" class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3.5 py-1.5 text-sm font-medium text-amber-700 dark:bg-amber-900/20 dark:text-amber-400"></span>
              <span id="result-rank" class="inline-flex items-center gap-1.5 rounded-full bg-zodiac-gold/15 px-3.5 py-1.5 text-sm font-medium text-zodiac-bronze dark:bg-zodiac-gold/10 dark:text-amber-400"></span>
            </div>
            <div id="result-tags" class="mt-3 flex flex-wrap gap-2 stagger-3"></div>
          </div>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-3 stagger-1">
          <div class="rounded-xl border border-zodiac-gold/20 bg-zodiac-cream/70 p-5 dark:border-stone-700 dark:bg-stone-800/50">
            <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-zodiac-red">Lucky Numbers</h3>
            <div class="flex flex-wrap gap-2" id="result-numbers"></div>
          </div>
          <div class="rounded-xl border border-zodiac-gold/20 bg-zodiac-cream/70 p-5 dark:border-stone-700 dark:bg-stone-800/50">
            <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-zodiac-red">Lucky Colors</h3>
            <div class="flex flex-wrap gap-2" id="result-colors"></div>
          </div>
          <div class="rounded-xl border border-zodiac-gold/20 bg-zodiac-cream/70 p-5 dark:border-stone-700 dark:bg-stone-800/50">
            <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-zodiac-red">Lucky Flowers</h3>
            <div class="flex flex-wrap gap-2" id="result-flowers"></div>
          </div>
        </div>

        <div class="mt-5 grid gap-4 sm:grid-cols-2 stagger-2">
          <div class="rounded-xl border border-zodiac-gold/15 bg-zodiac-cream/60 p-5 dark:border-zodiac-gold/10 dark:bg-stone-800/50">
            <h3 class="mb-2 text-xs font-semibold uppercase tracking-widest text-green-700 dark:text-green-400">Best Matches</h3>
            <div class="flex flex-wrap gap-2" id="result-best"></div>
          </div>
          <div class="rounded-xl border border-zodiac-gold/15 bg-zodiac-cream/60 p-5 dark:border-zodiac-gold/10 dark:bg-stone-800/50">
            <h3 class="mb-2 text-xs font-semibold uppercase tracking-widest text-red-600 dark:text-red-400">Challenging Matches</h3>
            <div class="flex flex-wrap gap-2" id="result-worst"></div>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap justify-center gap-3 stagger-3" id="result-ctas"></div>
      </div>
    </div>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="border-t border-zodiac-gold/15 bg-zodiac-cream/70 px-4 py-16 dark:border-stone-800 dark:bg-stone-950">
    <div class="mx-auto max-w-[900px]">
      <div class="mb-8 flex items-center justify-center gap-3">
        <span class="h-px w-8 bg-gradient-to-r from-transparent to-zodiac-gold/60"></span>
        <span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-zodiac-gold">3 Simple Steps</span>
        <span class="h-px w-8 bg-gradient-to-l from-transparent to-zodiac-gold/60"></span>
      </div>
      <h2 class="mb-3 text-center font-display text-3xl font-bold tracking-tight text-zodiac-ink dark:text-stone-100 sm:text-4xl">How It Works</h2>
      <p class="mb-10 text-center text-stone-500 dark:text-stone-400">
        Three simple steps to discover your Chinese zodiac profile
      </p>
      <div class="grid gap-6 sm:grid-cols-3">
        <div class="rounded-2xl border border-zodiac-gold/25 bg-white p-6 text-center shadow-sm transition-all hover:-translate-y-1 hover:border-zodiac-red/40 hover:shadow-md dark:border-zodiac-gold/20 dark:bg-stone-900">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-zodiac-deep text-2xl font-bold text-white shadow-md shadow-red-900/20 ring-2 ring-zodiac-gold/40">1</span>
          <h3 class="mt-4 text-lg font-semibold text-zodiac-ink dark:text-stone-100">Enter Your Birth Date</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">Choose a quick year lookup or full birth date with automatic lunar calendar correction — accurate from 1900.</p>
        </div>
        <div class="rounded-2xl border border-zodiac-gold/25 bg-white p-6 text-center shadow-sm transition-all hover:-translate-y-1 hover:border-zodiac-red/40 hover:shadow-md dark:border-zodiac-gold/20 dark:bg-stone-900">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-zodiac-deep text-2xl font-bold text-white shadow-md shadow-red-900/20 ring-2 ring-zodiac-gold/40">2</span>
          <h3 class="mt-4 text-lg font-semibold text-zodiac-ink dark:text-stone-100">Discover Your Sign</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">Get your animal sign, Chinese character, element, yin/yang, personality tags, lucky items, and compatibility matches instantly.</p>
        </div>
        <div class="rounded-2xl border border-zodiac-gold/25 bg-white p-6 text-center shadow-sm transition-all hover:-translate-y-1 hover:border-zodiac-red/40 hover:shadow-md dark:border-zodiac-gold/20 dark:bg-stone-900">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-zodiac-deep text-2xl font-bold text-white shadow-md shadow-red-900/20 ring-2 ring-zodiac-gold/40">3</span>
          <h3 class="mt-4 text-lg font-semibold text-zodiac-ink dark:text-stone-100">Explore Deeper</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">Dive into full personality profiles, detailed compatibility analysis, yearly horoscopes, and feng shui tips for your sign.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== ZODIAC GALLERY ===== -->
  <section class="px-4 py-16">
    <div class="mx-auto max-w-[1200px]">
      <div class="mb-8 flex items-center justify-center gap-3">
        <span class="h-px w-8 bg-gradient-to-r from-transparent to-zodiac-gold/60"></span>
        <span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-zodiac-gold">十二生肖 · Shēngxiào</span>
        <span class="h-px w-8 bg-gradient-to-l from-transparent to-zodiac-gold/60"></span>
      </div>
      <h2 class="mb-3 text-center font-display text-3xl font-bold tracking-tight text-zodiac-ink dark:text-stone-100 sm:text-4xl">The 12 Chinese Zodiac Signs</h2>
      <p class="mb-10 text-center text-stone-500 dark:text-stone-400">Click any sign to explore its complete personality profile</p>
      <div class="grid gap-5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
        {animals.map((a) => {
          const yeardata = zodiacYears.find((y) => y.animal === a.id);
          const recentYears = yeardata?.years?.slice(-3) || [];
          return (
            <a
              href={`/signs/${a.id}`}
              class="group flex flex-col items-center rounded-2xl border border-zodiac-gold/25 bg-white/90 p-5 text-center shadow-sm transition-all hover:-translate-y-1 hover:border-zodiac-red/40 hover:shadow-md dark:border-zodiac-gold/20 dark:bg-stone-900 dark:hover:border-zodiac-red/40"
            >
              <span class="flex h-14 w-14 items-center justify-center rounded-full border-2 border-zodiac-gold/40 bg-zodiac-cream text-2xl font-bold text-zodiac-ink transition-all duration-300 group-hover:-translate-y-0.5 group-hover:border-zodiac-red group-hover:bg-zodiac-red group-hover:text-white dark:bg-stone-800 dark:text-stone-200" style="font-family: var(--font-cn)">{a.chinese}</span>
              <h3 class="mt-3 text-base font-semibold capitalize text-zodiac-ink transition-colors group-hover:text-zodiac-red dark:text-stone-100">{a.id}</h3>
              <p class="mt-1 text-xs text-stone-500 dark:text-stone-400">{a.element} &middot; {a.yinYang} &middot; #{a.rank}</p>
              {recentYears.length > 0 && (
                <p class="mt-2 text-[11px] tracking-wide text-zodiac-gold/80 dark:text-zodiac-gold/70">
                  {recentYears.join(" · ")}
                </p>
              )}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ===== YEAR REFERENCE TABLE ===== -->
