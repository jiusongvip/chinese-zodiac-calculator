---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCompatibility, ZODIAC_ANIMALS, COMPATIBILITY, COMPATIBILITY_DETAILS, getCompatibilityDescription } from "../data/zodiac";

const compatGuide = ZODIAC_ANIMALS.map((a) => {
  const data = COMPATIBILITY[a.id as keyof typeof COMPATIBILITY];
  return {
    id: a.id,
    chinese: a.chinese,
    bestPairs: data.best.map((b) => ({ partner: b, text: getCompatibilityDescription(a.id, b).text })),
    worstPairs: data.worst.map((b) => ({ partner: b, text: getCompatibilityDescription(a.id, b).text })),
  };
});

const faqs = [
  { q: "What is Chinese zodiac compatibility?", a: "Chinese zodiac compatibility is a traditional system that evaluates how well two animal signs relate to each other based on their personality traits, elemental influences, and the 12-year cycle of the Chinese zodiac. This system is often used to assess romantic relationships, friendships, and business partnerships. It draws from Chinese astrology principles that have been observed and refined over thousands of years." },
  { q: "Which signs are most compatible?", a: "The most compatible pairings are signs that are four years apart in the zodiac cycle. These are called the \"secret friends\" or \"best match\" pairs. The classic best matches include Rat with Dragon and Monkey, Ox with Snake and Rooster, and Tiger with Horse and Dog. These pairs share complementary traits and balanced elemental energies that create natural harmony. The full matrix above shows how every sign relates to every other sign." },
  { q: "Can incompatible signs have a good relationship?", a: "Absolutely. Chinese zodiac compatibility is a guide, not a rule. Every relationship is unique and shaped by individual personalities, life experiences, and mutual effort. Signs that are considered \"challenging\" can build deeply rewarding relationships by understanding their differences and working through them. In fact, some of the strongest partnerships are formed between signs that push each other to grow. Use compatibility as a tool for self-awareness, not a limitation." },
  { q: "What is the difference between best, neutral, and challenging matches?", a: "Best matches (also called secret friends) are signs that naturally harmonize — usually four years apart in the cycle — and share complementary traits. Neutral matches have no strong conflicts but need conscious effort to deepen understanding. Challenging matches face natural friction from clashing personalities or clashing elements, but can still succeed with patience, communication, and compromise." },
  { q: "Which signs clash in the 2026 Fire Horse year?", a: "In 2026, the Horse year creates friction with three signs: Rat (opposition, zi-wu clash), Ox (harm, chou-wu), and Rabbit (breakage, mao-wu). People born under these signs traditionally take extra care with major decisions during 2026 — see our <a href=\"/tai-sui/\" class=\"font-medium text-zodiac-red underline-offset-2 hover:underline\">Tai Sui guide</a> for details and remedies." },
];
---

<BaseLayout
  title="Chinese Zodiac Compatibility Guide"
  description="Check the compatibility between any two Chinese zodiac signs. Discover the best love matches, clashing pairs, and relationship tips from our guide."
  breadcrumbs={[{label:"Home",href:"/"},{label:"Compatibility",href:"/compatibility/"}]}
  articleSchema={true}
  faqSchema={faqs}
  dateModified="2026-08-19"
  ogImage="/og/compatibility.png"
>
  <section class="relative overflow-hidden bg-zodiac-cream px-4 py-16 text-center lg:px-6 dark:bg-stone-950">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-transparent via-zodiac-gold/70 to-transparent"></div>
      <div class="absolute -left-44 -top-44 h-[26rem] w-[26rem] rounded-full bg-zodiac-red/10 blur-3xl dark:bg-zodiac-red/10"></div>
      <div class="absolute -bottom-52 -right-52 h-[30rem] w-[30rem] rounded-full bg-zodiac-gold/15 blur-3xl dark:bg-zodiac-gold/10"></div>
    </div>
    <div class="relative">
      <div class="mb-6 flex items-center justify-center gap-3">
        <span class="h-px w-10 bg-gradient-to-r from-transparent to-zodiac-gold/70"></span>
        <span class="inline-flex items-center justify-center rounded-[5px] bg-zodiac-red px-2 py-1 text-xs font-bold tracking-widest text-white shadow-md shadow-red-900/20" style="font-family: var(--font-cn)">缘</span>
        <span class="hidden text-[11px] font-semibold uppercase tracking-[0.35em] text-zodiac-gold sm:inline">Yuánfèn</span>
        <span class="h-px w-10 bg-gradient-to-l from-transparent to-zodiac-gold/70"></span>
      </div>
      <h1 class="font-display text-4xl font-bold tracking-tight text-zodiac-ink sm:text-5xl">Chinese Zodiac <span class="bg-gradient-to-r from-zodiac-deep via-zodiac-red to-zodiac-bronze bg-clip-text pb-1 text-transparent">Compatibility</span> Calculator</h1>
      <p class="mt-4 text-lg text-stone-600">Select two signs to see how well they match</p>
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-4 pb-16 lg:px-6">
    <div class="mx-auto max-w-2xl rounded-2xl border border-zodiac-gold/25 bg-white p-8 shadow-md shadow-red-900/10 dark:border-zodiac-gold/20 dark:bg-stone-900">
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="sign1" class="mb-2 block text-sm font-medium text-stone-700">First Zodiac Sign</label>
          <select id="sign1" class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-900 outline-none transition-colors focus:border-zodiac-red focus:ring-2 focus:ring-red-100"></select>
        </div>
        <div>
          <label for="sign2" class="mb-2 block text-sm font-medium text-stone-700">Second Zodiac Sign</label>
          <select id="sign2" class="w-full rounded-xl border border-stone-300 bg-white px-4 py-3 text-stone-900 outline-none transition-colors focus:border-zodiac-red focus:ring-2 focus:ring-red-100"></select>
        </div>
      </div>
      <button id="check-btn" class="mt-6 w-full cursor-pointer rounded-xl bg-zodiac-red px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-red-700">Check Compatibility</button>
      <div id="result" class="mt-8 hidden">
        <div class="rounded-xl border border-zodiac-gold/25 bg-zodiac-cream p-6 text-center shadow-md shadow-red-900/10">
          <div class="flex items-center justify-center gap-3 text-lg font-semibold text-stone-800">
            <span id="result-sign1"></span>
            <span class="text-stone-400">&amp;</span>
            <span id="result-sign2"></span>
          </div>
          <div id="result-stars" class="mt-3 text-2xl"></div>
          <span id="result-label" class="mt-2 inline-block rounded-full px-4 py-1 text-sm font-semibold"></span>
          <p id="result-desc" class="mt-4 text-stone-600 leading-relaxed"></p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-zodiac-cream/70 dark:bg-stone-950">
    <div class="mx-auto max-w-[1200px] px-4 py-16 lg:px-6">
      <h2 class="text-center font-display text-3xl font-bold tracking-tight text-zodiac-ink">Compatibility Matrix</h2>
      <p class="mt-2 text-center text-stone-600">A quick overview of how every zodiac sign pairs with each other</p>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[600px] border-collapse text-sm">
          <thead>
            <tr>
              <th class="p-2 text-left font-semibold text-stone-600"></th>
              {ZODIAC_ANIMALS.map((a) => (
                <th class="p-2 text-center font-semibold text-stone-700 capitalize">{a.id}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {ZODIAC_ANIMALS.map((row, ri) => (
              <tr>
                <td class="p-2 font-semibold text-stone-700 capitalize whitespace-nowrap">{row.id}</td>
                {ZODIAC_ANIMALS.map((col, ci) => {
                  if (ri === ci) {
                    return <td class="p-2 text-center rounded" style="background:#f5f5f4">—</td>;
                  }
                  const result = getCompatibility(row.id, col.id);
                  if (result.score === 5) {
                    return <td class="p-2 text-center rounded" style="background:#dcfce7;color:#166534;font-weight:600">★</td>;
                  }
                  if (result.score === 1) {
                    return <td class="p-2 text-center rounded" style="background:#fee2e2;color:#991b1b;font-weight:600">☆</td>;
                  }
                  return <td class="p-2 text-center rounded" style="background:#fef9c3;color:#854d0e">●</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="mt-4 flex flex-wrap justify-center gap-6 text-sm text-stone-600">
        <span class="inline-flex items-center gap-2"><span class="inline-block h-4 w-4 rounded" style="background:#dcfce7"></span> Best Match</span>
        <span class="inline-flex items-center gap-2"><span class="inline-block h-4 w-4 rounded" style="background:#fef9c3"></span> Neutral Match</span>
        <span class="inline-flex items-center gap-2"><span class="inline-block h-4 w-4 rounded" style="background:#fee2e2"></span> Challenging Match</span>
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-[1200px] px-4 py-16 lg:px-6">
      <h2 class="text-3xl font-bold tracking-tight text-zodiac-ink text-center">Best &amp; Worst Matches</h2>
      <p class="mt-2 text-center text-stone-600">Discover which zodiac pairings are most harmonious and which require extra effort</p>
      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <div>
          <h3 class="text-xl font-semibold text-zodiac-ink flex items-center gap-2"><span class="text-2xl">&#x1F31F;</span> Best Matches</h3>
          <p class="mt-1 text-sm text-stone-500">These pairings share natural chemistry and mutual understanding.</p>
          <ul class="mt-4 space-y-3">
            <li class="rounded-xl border border-zodiac-gold/25 bg-white p-4 shadow-sm shadow-red-900/5"><strong class="text-zodiac-ink">Rat + Dragon:</strong> <span class="text-stone-600">An ambitious power couple. Both are confident and driven, building success together through mutual respect and shared goals.</span></li>
            <li class="rounded-xl border border-zodiac-gold/25 bg-white p-4 shadow-sm shadow-red-900/5"><strong class="text-zodiac-ink">Rat + Monkey:</strong> <span class="text-stone-600">A playful, intellectually stimulating pair. Their clever banter and shared wit keep the relationship fresh and exciting.</span></li>
            <li class="rounded-xl border border-zodiac-gold/25 bg-white p-4 shadow-sm shadow-red-900/5"><strong class="text-zodiac-ink">Ox + Snake:</strong> <span class="text-stone-600">A calm, deeply loyal match. The Ox provides stability while the Snake offers wisdom and strategic thinking.</span></li>
            <li class="rounded-xl border border-zodiac-gold/25 bg-white p-4 shadow-sm shadow-red-900/5"><strong class="text-zodiac-ink">Tiger + Horse:</strong> <span class="text-stone-600">An adventurous, high-energy duo. Both love freedom and action, making them natural partners in exploration.</span></li>
            <li class="rounded-xl border border-zodiac-gold/25 bg-white p-4 shadow-sm shadow-red-900/5"><strong class="text-zodiac-ink">Dragon + Rooster:</strong> <span class="text-stone-600">A confident and successful pair. The Dragon dreams big and the Rooster handles the details — a perfect execution team.</span></li>
            <li class="rounded-xl border border-zodiac-gold/25 bg-white p-4 shadow-sm shadow-red-900/5"><strong class="text-zodiac-ink">Rabbit + Goat:</strong> <span class="text-stone-600">A gentle, artistic match. Both value harmony and beauty, creating a peaceful and nurturing home together.</span></li>
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-semibold text-zodiac-ink flex items-center gap-2"><span class="text-2xl">&#x26A0;</span> Challenging Matches</h3>
          <p class="mt-1 text-sm text-stone-500">These pairings face natural friction but can succeed with understanding and compromise.</p>
          <ul class="mt-4 space-y-3">
            <li class="rounded-xl border border-zodiac-gold/25 bg-white p-4 shadow-sm shadow-red-900/5"><strong class="text-zodiac-ink">Rat + Horse:</strong> <span class="text-stone-600">The Rat is cautious and detail-oriented while the Horse is impulsive and freedom-loving. Their pacing and priorities often clash.</span></li>
            <li class="rounded-xl border border-zodiac-gold/25 bg-white p-4 shadow-sm shadow-red-900/5"><strong class="text-zodiac-ink">Ox + Goat:</strong> <span class="text-stone-600">The Ox values routine and blunt honesty, while the Goat is sensitive and artistic. Misunderstandings arise from their different emotional languages.</span></li>
            <li class="rounded-xl border border-zodiac-gold/25 bg-white p-4 shadow-sm shadow-red-900/5"><strong class="text-zodiac-ink">Tiger + Monkey:</strong> <span class="text-stone-600">Both are clever and competitive, but their strong personalities can lead to power struggles and a battle of wills.</span></li>
            <li class="rounded-xl border border-zodiac-gold/25 bg-white p-4 shadow-sm shadow-red-900/5"><strong class="text-zodiac-ink">Rabbit + Rooster:</strong> <span class="text-stone-600">The Rabbit craves peace and quiet while the Rooster is direct and critical. Their communication styles are fundamentally different.</span></li>
            <li class="rounded-xl border border-zodiac-gold/25 bg-white p-4 shadow-sm shadow-red-900/5"><strong class="text-zodiac-ink">Dragon + Dog:</strong> <span class="text-stone-600">The Dragon is bold and visionary, the Dog is loyal and practical. The Dragon may seem arrogant to the Dog, while the Dog seems pessimistic to the Dragon.</span></li>
            <li class="rounded-xl border border-zodiac-gold/25 bg-white p-4 shadow-sm shadow-red-900/5"><strong class="text-zodiac-ink">Snake + Pig:</strong> <span class="text-stone-600">The Snake is private and analytical, the Pig is open and trusting. Their contrasting approaches to intimacy can create distance.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-[1200px] px-4 py-16 lg:px-6">
      <h2 class="text-3xl font-bold tracking-tight text-zodiac-ink text-center">Sign-by-Sign Compatibility Guide</h2>
      <p class="mt-2 text-center text-stone-600">Detailed pairing insights for every zodiac sign — best matches and challenging matches with explanations</p>
      <div class="mt-10 space-y-6">
        {compatGuide.map((s) => (
          <div class="rounded-2xl border border-zodiac-gold/25 bg-white p-6 shadow-md shadow-red-900/10">
            <div class="mb-4 flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-zodiac-cream text-2xl">{s.chinese}</span>
              <h3 class="text-xl font-semibold capitalize text-zodiac-ink">{s.id} Compatibility</h3>
            </div>
            <div class="grid gap-4 md:grid-cols-2">
              <div class="rounded-xl border border-zodiac-gold/30 bg-amber-50/50 p-4 dark:border-zodiac-gold/20 dark:bg-amber-900/10">
                <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-green-700 dark:text-green-400">Best Matches</h3>
                <ul class="space-y-3">
                  {s.bestPairs.map((p) => (
                    <li class="text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                      <a href={`/signs/${p.partner}/`} class="font-semibold capitalize text-zodiac-ink no-underline transition-colors hover:text-zodiac-red dark:text-stone-200 dark:hover:text-zodiac-red">{s.id} + {p.partner}</a> — {p.text}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="rounded-xl border border-zodiac-red/20 bg-red-50/50 p-4 dark:border-zodiac-red/20 dark:bg-red-900/10">
                <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-red-600 dark:text-red-400">Challenging Matches</h3>
                <ul class="space-y-3">
                  {s.worstPairs.map((p) => (
                    <li class="text-sm leading-relaxed text-stone-600 dark:text-stone-400">
                      <a href={`/signs/${p.partner}/`} class="font-semibold capitalize text-zodiac-ink no-underline transition-colors hover:text-zodiac-red dark:text-stone-200 dark:hover:text-zodiac-red">{s.id} + {p.partner}</a> — {p.text}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-zodiac-cream/70">
    <div class="mx-auto max-w-[800px] px-4 py-16 lg:px-6">
      <h2 class="text-3xl font-bold tracking-tight text-zodiac-ink text-center">Frequently Asked Questions</h2>
      <div class="mt-8 space-y-4">
        {faqs.map((faq) => (
          <details class="group cursor-pointer rounded-xl border border-zodiac-gold/25 bg-white p-6 shadow-sm shadow-red-900/5">
            <summary class="flex items-center justify-between text-lg font-semibold text-zodiac-ink [&::-webkit-details-marker]:hidden">
              {faq.q}
              <svg class="h-5 w-5 text-stone-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="mt-4 text-stone-600 leading-relaxed" set:html={faq.a}></p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <script type="application/json" id="compat-data" set:html={JSON.stringify({
    animals: ZODIAC_ANIMALS.map((a) => ({ id: a.id, name: a.id.charAt(0).toUpperCase() + a.id.slice(1) })),
    compatData: COMPATIBILITY,
    descriptions: COMPATIBILITY_DETAILS,
  })}></script>
</BaseLayout>

<script is:inline>
(function () {
  var dataEl = document.getElementById('compat-data');
  var injected = dataEl ? JSON.parse(dataEl.textContent) : null;
  var animals = injected ? injected.animals : [];
  var compatData = injected ? injected.compatData : {};
  var descriptions = injected ? injected.descriptions : { best: {}, worst: {}, neutral: '' };

  function capitalize(str) {
    return str.charAt(0).toUpperCase() + str.slice(1);
  }

  function populateSelects() {
    var s1 = document.getElementById('sign1');
    var s2 = document.getElementById('sign2');
    if (!s1 || !s2) return;
    var html = '<option value="">Select a sign</option>';
    for (var i = 0; i < animals.length; i++) {
      html += '<option value="' + animals[i].id + '">' + animals[i].name + '</option>';
    }
    s1.innerHTML = html;
    s2.innerHTML = html;
  }

  function getCompat(sign1, sign2) {
    var data = compatData[sign1];
    if (!data) return { score: 0, label: 'Unknown' };
    if (data.best.indexOf(sign2) !== -1) return { score: 5, label: 'Best Match' };
    if (data.worst.indexOf(sign2) !== -1) return { score: 1, label: 'Challenging Match' };
    return { score: 3, label: 'Neutral Match' };
  }

  function getDescription(sign1, sign2, result) {
    var key;
    if (result.label === 'Best Match') {
      key = sign1 + '_' + sign2;
      if (descriptions.best[key]) return descriptions.best[key];
      key = sign2 + '_' + sign1;
      if (descriptions.best[key]) return descriptions.best[key];
      return 'A naturally harmonious pairing. These two signs share complementary traits and build a strong, supportive connection.';
    }
    if (result.label === 'Challenging Match') {
      key = sign1 + '_' + sign2;
      if (descriptions.worst[key]) return descriptions.worst[key];
      key = sign2 + '_' + sign1;
      if (descriptions.worst[key]) return descriptions.worst[key];
      return 'This pairing faces natural friction. With patience, understanding, and open communication, these differences can become strengths.';
    }
    return descriptions.neutral;
  }

  function getStarColor(score) {
    if (score === 5) return '#16a34a';
    if (score === 1) return '#dc2626';
    return '#ca8a04';
  }

  function getLabelClass(label) {
    if (label === 'Best Match') return 'bg-green-100 text-green-800';
    if (label === 'Challenging Match') return 'bg-red-100 text-red-800';
    return 'bg-yellow-100 text-yellow-800';
  }

  function checkCompatibility() {
    var s1 = document.getElementById('sign1');
    var s2 = document.getElementById('sign2');
    var result = document.getElementById('result');
    var rs1 = document.getElementById('result-sign1');
    var rs2 = document.getElementById('result-sign2');
    var rStars = document.getElementById('result-stars');
    var rLabel = document.getElementById('result-label');
    var rDesc = document.getElementById('result-desc');

    if (!s1 || !s2 || !result || !rs1 || !rs2 || !rStars || !rLabel || !rDesc) return;

    var val1 = s1.value;
    var val2 = s2.value;

    if (!val1 || !val2) {
      alert('Please select both zodiac signs.');
      return;
    }

    if (val1 === val2) {
      alert('Please select two different zodiac signs.');
      return;
    }

    var compat = getCompat(val1, val2);
    var name1 = capitalize(val1);
    var name2 = capitalize(val2);

    rs1.textContent = name1;
    rs2.textContent = name2;

    rStars.textContent = '';
    for (var i = 0; i < 5; i++) {
      var star = document.createElement('span');
      if (i < compat.score) {
        star.textContent = '\u2605';
        star.style.color = getStarColor(compat.score);
      } else {
        star.textContent = '\u2606';
        star.style.color = '#d4d4d4';
      }
      star.className = 'inline-block mx-0.5';
      rStars.appendChild(star);
    }

    rLabel.textContent = compat.label;
    rLabel.className = 'mt-2 inline-block rounded-full px-4 py-1 text-sm font-semibold ' + getLabelClass(compat.label);

    rDesc.textContent = getDescription(val1, val2, compat);

    result.classList.remove('hidden');
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  document.addEventListener('DOMContentLoaded', function () {
    populateSelects();
    var btn = document.getElementById('check-btn');
    if (btn) {
      btn.addEventListener('click', checkCompatibility);
    }
  });
})();
</script>