---
import BaseLayout from "../layouts/BaseLayout.astro";

const taiSui2026 = [
  {
    sign: "horse",
    chinese: "马",
    name: "Horse",
    form: "值太岁 (Zhí Tàisuì) — Standing Before Tai Sui",
    tag: "Zodiac Year of Birth",
    color: "red",
    summary: "2026 is the Horse's own year, making it the most direct form of offending Tai Sui. Horses also face 刑太岁 (self-punishment, wu-wu xing), compounding the intensity.",
    impact: "Expect a year of extremes: rapid career opportunities, relationship intensity, and sudden changes. Health and finances demand extra care. Traditional advice: pace yourself, avoid impulsive decisions, and take the year's momentum deliberately.",
    remedies: "Wear red from New Year's Eve, visit a temple to worship Tai Sui early in the year, keep a regular health schedule, and avoid major construction or house moves during the year if possible.",
    link: "/signs/horse/",
  },
  {
    sign: "rat",
    chinese: "鼠",
    name: "Rat",
    form: "冲太岁 (Chōng Tàisuì) — Clashing With Tai Sui",
    tag: "Direct Opposition",
    color: "red",
    summary: "The Rat sits directly opposite the Horse on the zodiac wheel (子午相冲, zi-wu clash). Opposition is traditionally considered the most turbulent form of offending Tai Sui.",
    impact: "Watch for sudden disruptions: job changes, relationship strain, relocation, and travel mishaps. Matters that normally go smoothly may face unexpected resistance. Stay flexible and keep contingency plans.",
    remedies: "Wear red or a protective charm, worship Tai Sui, avoid confrontational decisions in January and July, and delay major moves until the second half of the year when the clash softens.",
    link: "/signs/rat/",
  },
  {
    sign: "ox",
    chinese: "牛",
    name: "Ox",
    form: "害太岁 (Hài Tàisuì) — Harming Tai Sui",
    tag: "Hidden Friction",
    color: "amber",
    summary: "The Ox harms the Horse (丑午相害, chou-wu harm). This is a subtle, corrosive form of offending Tai Sui — problems build quietly rather than striking suddenly.",
    impact: "Expect misunderstandings with colleagues and family, office politics, and small persistent losses. Documents and contracts deserve extra review. Avoid gossip and double-check everything you sign.",
    remedies: "Keep written records of agreements, communicate clearly to prevent misunderstandings, wear yellow or red accents, and make time for honest conversations with close partners.",
    link: "/signs/ox/",
  },
  {
    sign: "rabbit",
    chinese: "兔",
    name: "Rabbit",
    form: "破太岁 (Pò Tàisuì) — Breaking With Tai Sui",
    tag: "Setbacks & Breakage",
    color: "amber",
    summary: "The Rabbit breaks the Horse's energy (卯午相破, mao-wu break). This form brings disruption without full conflict — broken plans, spoiled deals, and minor losses.",
    impact: "Travel plans may be delayed, projects interrupted, and small items lost or damaged. The theme is fragmentation rather than disaster. Keep backup plans for important arrangements and insure valuable possessions.",
    remedies: "Build buffer time into your schedule, keep duplicates of important documents, wear purple or red, and practice patience — the breakage energy fades after the lunar month of May.",
    link: "/signs/rabbit/",
  },
];

const faqs = [
  { q: "What is Tai Sui (太岁)?", a: "Tai Sui (太岁), also called the Grand Duke of Jupiter, is the celestial deity who governs the fortune of each year in Chinese astrology. Each of the 12 earthly branches has its own Tai Sui general, and the general of the year rotates through the zodiac cycle. Tai Sui is not inherently hostile — it represents the year's authority. Trouble arises when your zodiac sign 'offends' (犯, fàn) the year's general, traditionally believed to bring turbulence in specific life areas." },
  { q: "Which signs offend Tai Sui in 2026?", a: "In 2026 (the Horse year), four signs offend Tai Sui: the Horse (值太岁, standing before Tai Sui — its Ben Ming Nian), the Rat (冲太岁, clashing — direct opposition), the Ox (害太岁, harming — hidden friction), and the Rabbit (破太岁, breaking — setbacks and breakage). The Horse also experiences 刑太岁 (self-punishment) because Horse meets Horse in the punishment cycle." },
  { q: "What is the difference between Zhi, Chong, Hai, and Po Tai Sui?", a: "值太岁 (Zhi) means your sign is the same as the year's sign — you 'stand before' the Grand Duke; it amplifies both highs and lows. 冲太岁 (Chong) means your sign is opposite the year's sign — direct confrontation, traditionally the most turbulent form. 害太岁 (Hai) means your sign harms the year's sign — subtle friction and misunderstandings. 破太岁 (Po) means your sign breaks the year's energy — minor losses and interrupted plans. 刑太岁 (Xing) is punishment — often self-inflicted friction, sometimes grouped with the others." },
  { q: "How do I resolve offending Tai Sui?", a: "Traditional remedies include: (1) worshipping Tai Sui at a temple early in the year, ideally before the 15th day of the first lunar month; (2) wearing red items — belts, socks, underwear, or strings; (3) carrying a protective charm for your sign; (4) avoiding major construction in the Tai Sui direction (south in 2026) and the year-opposite direction (north); and (5) practicing restraint — the year rewards caution, not risk. Modern practitioners add the practical layer: keep your finances conservative, your health monitored, and your decisions deliberate." },
  { q: "Is offending Tai Sui really bad luck?", a: "Traditional Chinese astrology treats offending Tai Sui as a year of increased turbulence — greater highs AND greater lows — rather than pure bad luck. For the Horse in 2026, the year brings exceptional opportunity alongside exceptional risk. Many people experience their biggest life changes during such years. The practical view: awareness is the remedy. Knowing the patterns helps you plan around them, and the year's energy can be channeled productively." },
  { q: "What is the Tai Sui direction in 2026?", a: "Tai Sui's seat for the 2026 Horse year is due south (the Horse rules the south). The opposing direction (岁破方) is due north. Traditional guidance: avoid starting major renovations, ground-breaking, or significant construction facing or inside these two sectors. For daily life, simply being aware of the directions is enough — no need for drastic changes." },
];

const remedies = [
  { title: "Worship Tai Sui early", detail: "Visit a temple between New Year's Eve and the 15th day of the first lunar month. Offer incense and make a clear intention for the year — this is the most traditional and widely practiced remedy." },
  { title: "Wear red", detail: "Red belts, socks, underwear, and strings are the classic protective items. Put them on at Chinese New Year's Eve and wear them through the year — red symbolizes fire, which dispels negative energy." },
  { title: "Carry a lucky charm", detail: "A jade pendant, a charm of your zodiac animal, or a Tai Sui talisman (太岁符) obtained from a temple. Keep it on you or in your bag; renew talismans annually." },
  { title: "Mind the Tai Sui directions", detail: "In 2026, avoid major renovation in the south (Tai Sui's seat) and north (the opposing direction). If you must build, choose an auspicious date and consult a professional." },
  { title: "Stay conservative and kind", detail: "Hold off on impulsive investments, gambling, and risky ventures. Practice generosity — donations and acts of kindness are traditionally said to soften the year's friction." },
  { title: "Check your yearly horoscope", detail: "Read your <a href=\"/yearly-horoscope/\" class=\"font-medium text-zodiac-red underline-offset-2 hover:underline\">2026 horoscope</a> and your <a href=\"/signs/horse/\" class=\"font-medium text-zodiac-red underline-offset-2 hover:underline\">sign profile</a> for season-by-season guidance tailored to your element." },
];
---

<BaseLayout
  title="Tai Sui (太岁) 2026: Signs & Remedies"
  description="Which zodiac signs offend Tai Sui (犯太岁) in 2026? Horse, Rat, Ox, and Rabbit — learn the four forms and traditional remedies to appease the Grand Duke."
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Tai Sui", href: "/tai-sui/" }]}
  articleSchema={true}
  faqSchema={faqs}
  dateModified="2026-08-19"
  ogImage="/og/tai-sui.png"
>
  <article class="relative mx-auto max-w-[1000px] px-4 py-12 lg:px-6 lg:py-16">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-transparent via-zodiac-gold/70 to-transparent" aria-hidden="true"></div>
    <!-- Hero -->
    <header class="text-center">
      <div class="mb-6 flex items-center justify-center gap-3">
        <span class="h-px w-10 bg-gradient-to-r from-transparent to-zodiac-gold/70"></span>
        <span class="inline-flex items-center justify-center rounded-[5px] bg-zodiac-red px-2 py-1 text-xs font-bold tracking-widest text-white shadow-md shadow-red-900/20" style="font-family: var(--font-cn)">太岁</span>
        <span class="hidden text-[11px] font-semibold uppercase tracking-[0.35em] text-zodiac-gold sm:inline">Tài Suì</span>
        <span class="h-px w-10 bg-gradient-to-l from-transparent to-zodiac-gold/70"></span>
      </div>
      <h1 class="font-display text-3xl font-bold tracking-tight text-zodiac-ink dark:text-stone-100 md:text-4xl">
        Tai Sui <span class="bg-gradient-to-r from-zodiac-deep via-zodiac-red to-zodiac-bronze bg-clip-text pb-1 text-transparent">(太岁)</span> 2026 — Offending Signs &amp; Remedies
      </h1>
      <p class="mx-auto mt-3 max-w-[680px] text-base leading-relaxed text-stone-500 dark:text-stone-400">
        Tai Sui, the Grand Duke of the year, sits in the south in 2026. Four signs offend him — Horse, Rat, Ox, and Rabbit. Here is what that means and how tradition says to respond.
      </p>
    </header>

    <!-- What is Tai Sui -->
    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">What Is Tai Sui?</h2>
      <div class="mt-4 space-y-4 rounded-2xl border border-zodiac-gold/25 bg-white p-6 shadow-md shadow-red-900/10 dark:border-zodiac-gold/15 dark:bg-stone-800 sm:p-8">
        <p class="text-base leading-relaxed text-stone-600 dark:text-stone-300">
          <strong class="text-zodiac-ink dark:text-stone-100">Tai Sui</strong> (太岁, literally "the Great Year") is the celestial deity who governs each year's fortune — sometimes translated as the <strong class="text-zodiac-ink dark:text-stone-100">Grand Duke of Jupiter</strong>. In Chinese astrology, every year is ruled by one of twelve Tai Sui generals, one for each earthly branch. In 2026, the general of the Horse year (丙午, bǐng-wǔ) holds the seat of power.
        </p>
        <p class="text-base leading-relaxed text-stone-600 dark:text-stone-300">
          Tai Sui is not an enemy — he is the year's authority figure. But when your zodiac sign stands in his path, tradition says friction follows. This is called <strong class="text-zodiac-ink dark:text-stone-100">犯太岁 (fàn Tàisuì)</strong>, "offending Tai Sui," and it is one of the most common concerns in Chinese folk astrology. The metaphor is simple: when a king takes the throne, those closest to him — his own sign, his opponents, and those who cross him — experience the most turbulent year.
        </p>
      </div>
    </section>

    <!-- Four forms -->
    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">The Four Forms of Offending Tai Sui</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-zodiac-red/20 bg-red-50/50 p-5 dark:border-zodiac-red/20 dark:bg-red-900/10">
          <h3 class="text-sm font-semibold text-zodiac-red">值太岁 (Zhí) — Standing Before</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">Your sign IS the year's sign (Ben Ming Nian). The most direct form — a year of extremes: great opportunity, greater turbulence.</p>
        </div>
        <div class="rounded-xl border border-zodiac-red/20 bg-red-50/50 p-5 dark:border-zodiac-red/20 dark:bg-red-900/10">
          <h3 class="text-sm font-semibold text-zodiac-red">冲太岁 (Chōng) — Clashing</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">Your sign is directly opposite the year's sign. Traditionally the most turbulent form — sudden changes, moves, and confrontations.</p>
        </div>
        <div class="rounded-xl border border-zodiac-gold/30 bg-amber-50/50 p-5 dark:border-zodiac-gold/20 dark:bg-amber-900/10">
          <h3 class="text-sm font-semibold text-amber-700 dark:text-amber-400">害太岁 (Hài) — Harming</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">Your sign subtly harms the year's sign. Hidden friction: office politics, misunderstandings, and small persistent losses.</p>
        </div>
        <div class="rounded-xl border border-zodiac-gold/30 bg-amber-50/50 p-5 dark:border-zodiac-gold/20 dark:bg-amber-900/10">
          <h3 class="text-sm font-semibold text-amber-700 dark:text-amber-400">破太岁 (Pò) — Breaking</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">Your sign breaks the year's energy. Disruption without full conflict: delayed plans, spoiled deals, and minor losses.</p>
        </div>
      </div>
      <p class="mt-4 text-sm text-stone-500 dark:text-stone-400">
        A fifth form, 刑太岁 (Xíng, punishment), applies when your sign also meets itself in the punishment cycle — in 2026 this affects the Horse itself.
      </p>
    </section>

    <!-- 2026 offending signs -->
    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">Who Offends Tai Sui in 2026? (Horse Year)</h2>
      <p class="mt-2 text-sm text-stone-500 dark:text-stone-400">
        Four signs traditionally offend Tai Sui in the Year of the Fire Horse. Find your sign below.
      </p>
      <div class="mt-6 space-y-6">
        {taiSui2026.map((t) => (
          <div class="rounded-2xl border border-zodiac-gold/25 bg-white p-6 shadow-md shadow-red-900/10 dark:border-zodiac-gold/15 dark:bg-stone-800 sm:p-8">
            <div class="flex flex-wrap items-center gap-3">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-zodiac-cream text-3xl dark:bg-stone-700">{t.chinese}</span>
              <div class="flex-1">
                <h3 class="text-xl font-semibold capitalize text-zodiac-ink dark:text-stone-100">{t.name} — {t.form}</h3>
                <span class="mt-1 inline-block rounded-full bg-zodiac-red/10 px-3 py-1 text-xs font-medium text-zodiac-red">{t.tag}</span>
              </div>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t.summary}</p>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <div class="rounded-xl border border-zodiac-gold/15 bg-zodiac-cream/60 p-4 dark:border-zodiac-gold/10 dark:bg-stone-900/50">
                <h4 class="text-xs font-semibold uppercase tracking-widest text-zodiac-red">What to Expect</h4>
                <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t.impact}</p>
              </div>
              <div class="rounded-xl border border-zodiac-gold/15 bg-zodiac-cream/60 p-4 dark:border-zodiac-gold/10 dark:bg-stone-900/50">
                <h4 class="text-xs font-semibold uppercase tracking-widest text-green-700 dark:text-green-400">Traditional Remedies</h4>
                <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{t.remedies}</p>
              </div>
            </div>
            <p class="mt-4 text-xs text-stone-400 dark:text-stone-500">
              <a href={t.link} class="font-medium text-zodiac-red underline-offset-2 hover:underline">Full {t.name} profile &rarr;</a>
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Remedies -->
    <section class="mt-12 rounded-2xl bg-zodiac-cream/70 p-6 dark:bg-stone-800/50 sm:p-8">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">How to Reconcile With Tai Sui</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {remedies.map((r) => (
          <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 dark:border-zodiac-gold/15 dark:bg-stone-800">
            <h3 class="text-sm font-semibold text-zodiac-ink dark:text-stone-100">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300" set:html={r.detail}></p>
          </div>
        ))}
      </div>
    </section>

    <!-- Related -->
    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">Related Guides</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <a href="/ben-ming-nian/" class="group rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-zodiac-red/40 hover:shadow-md dark:border-zodiac-gold/15 dark:bg-stone-800">
          <h3 class="text-sm font-semibold text-zodiac-ink transition-colors group-hover:text-zodiac-red dark:text-stone-100">Ben Ming Nian</h3>
          <p class="mt-2 text-xs leading-relaxed text-stone-500 dark:text-stone-400">Your zodiac year of birth — the deepest form of offending Tai Sui.</p>
        </a>
        <a href="/yearly-horoscope/" class="group rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-zodiac-red/40 hover:shadow-md dark:border-zodiac-gold/15 dark:bg-stone-800">
          <h3 class="text-sm font-semibold text-zodiac-ink transition-colors group-hover:text-zodiac-red dark:text-stone-100">2026 Horoscopes</h3>
          <p class="mt-2 text-xs leading-relaxed text-stone-500 dark:text-stone-400">Season-by-season guidance for all 12 signs in the Fire Horse year.</p>
        </a>
        <a href="/compatibility/" class="group rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-zodiac-red/40 hover:shadow-md dark:border-zodiac-gold/15 dark:bg-stone-800">
          <h3 class="text-sm font-semibold text-zodiac-ink transition-colors group-hover:text-zodiac-red dark:text-stone-100">Compatibility</h3>
          <p class="mt-2 text-xs leading-relaxed text-stone-500 dark:text-stone-400">See how your sign pairs with every other sign.</p>
        </a>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">Frequently Asked Questions</h2>
      <div class="mt-6 space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 transition-shadow hover:shadow-md dark:border-zodiac-gold/15 dark:bg-stone-800">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-zodiac-ink dark:text-stone-100">
              {f.q}
              <svg class="h-4 w-4 shrink-0 text-stone-400 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-400" set:html={f.a}></p>
          </details>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
