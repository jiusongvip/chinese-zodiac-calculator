---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ZODIAC_ANIMALS, ELEMENTS, LUCKY_THINGS, COMPATIBILITY, ZODIAC_LUNAR_RANGES, SIGN_PROFILES, HOROSCOPES_2026, SIGN_META, BORN_ERAS } from "../../data/zodiac";

export async function getStaticPaths() {
  return ZODIAC_ANIMALS.map((animal) => ({
    params: { animal: animal.id },
  }));
}

const { animal } = Astro.params;
const currentAnimal = ZODIAC_ANIMALS.find((a) => a.id === animal)!;
const profile = SIGN_PROFILES[currentAnimal.id as keyof typeof SIGN_PROFILES];
const lucky = LUCKY_THINGS[currentAnimal.id as keyof typeof LUCKY_THINGS];
const compat = COMPATIBILITY[currentAnimal.id as keyof typeof COMPATIBILITY];
const horoscope = HOROSCOPES_2026[currentAnimal.id as keyof typeof HOROSCOPES_2026];
const rangeEntry = ZODIAC_LUNAR_RANGES.find((e) => e.animal === currentAnimal.id)!;
const bornEras = BORN_ERAS[currentAnimal.id as keyof typeof BORN_ERAS];
const displayName = currentAnimal.id.charAt(0).toUpperCase() + currentAnimal.id.slice(1);
const signMeta = SIGN_META[currentAnimal.id as keyof typeof SIGN_META];
const elem = ELEMENTS[currentAnimal.element as keyof typeof ELEMENTS];

const PINYIN: Record<string, string> = {
  rat: "shǔ", ox: "niú", tiger: "hǔ", rabbit: "tù", dragon: "lóng", snake: "shé",
  horse: "mǎ", goat: "yáng", monkey: "hóu", rooster: "jī", dog: "gǒu", pig: "zhū",
};

const otherAnimals = ZODIAC_ANIMALS.filter((a) => a.id !== animal);

const faqs = [
  { q: `What are the birth years of the ${displayName} sign?`, a: `${displayName}s are born in ${rangeEntry.ranges.map((r) => r.year).join(", ")}. In lunar calendar terms, the most recent ${displayName} years run ${rangeEntry.ranges.slice(-2).reverse().map((r) => `${r.start}, ${r.year} – ${r.end}`).join(" and ")}. If you were born in January or February, check the exact Chinese New Year date — your sign may belong to the previous year.` },
  { q: `What element is the ${displayName} in the Chinese zodiac?`, a: `The ${displayName} is a ${currentAnimal.element} sign (${currentAnimal.yinYang}). ${currentAnimal.element} people are generally ${elem.traits.toLowerCase()}. The element combines with your animal to refine your personality: for example, a ${currentAnimal.element} ${displayName} has a distinct temperament compared to ${currentAnimal.element === "Water" ? "Wood" : "Water"} ${displayName}s born in other cycles.` },
  { q: `Who is the ${displayName} most compatible with?`, a: `Traditionally, the ${displayName} matches best with ${compat.best.map((b) => b.charAt(0).toUpperCase() + b.slice(1)).join(", ")}. Relationships with ${compat.worst.map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(", ")} may require more effort but can still thrive with understanding and compromise.` },
  { q: `Is the ${displayName} lucky in 2026?`, a: `For ${displayName}s, 2026 (the Fire Horse year) brings mixed energy. ${horoscope} For a sign-specific reading, combine this general guidance with your exact birth date using our <a href="/bazi-calculator/" class="font-medium text-zodiac-red underline-offset-2 hover:underline">BaZi Calculator</a>.` },
  { q: `What does the ${displayName} sign symbolize?`, a: `In Chinese culture, the ${displayName} represents ${currentAnimal.id === "dragon" ? "power, success, and good fortune" : currentAnimal.id === "rat" ? "wealth, wit, and survival instinct" : currentAnimal.id === "ox" ? "hard work, reliability, and strength" : currentAnimal.id === "tiger" ? "courage, leadership, and protection" : currentAnimal.id === "rabbit" ? "peace, elegance, and good luck" : currentAnimal.id === "snake" ? "wisdom, mystery, and renewal" : currentAnimal.id === "horse" ? "freedom, energy, and progress" : currentAnimal.id === "goat" ? "creativity, gentleness, and harmony" : currentAnimal.id === "monkey" ? "intelligence, agility, and cleverness" : currentAnimal.id === "rooster" ? "punctuality, diligence, and confidence" : currentAnimal.id === "dog" ? "loyalty, honesty, and protection" : "wealth, generosity, and good fortune"}. ${currentAnimal.chinese} (${PINYIN[currentAnimal.id]}) is the ${currentAnimal.rank === 1 ? "first" : currentAnimal.rank === 2 ? "second" : currentAnimal.rank === 3 ? "third" : currentAnimal.rank === 4 ? "fourth" : currentAnimal.rank === 5 ? "fifth" : currentAnimal.rank === 6 ? "sixth" : currentAnimal.rank === 7 ? "seventh" : currentAnimal.rank === 8 ? "eighth" : currentAnimal.rank === 9 ? "ninth" : currentAnimal.rank === 10 ? "tenth" : currentAnimal.rank === 11 ? "eleventh" : "twelfth"} sign of the 12-year cycle.` },
];
---

<BaseLayout
  title={`${displayName} Chinese Zodiac Sign Guide`}
  description={signMeta.metaDescription}
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Zodiac Signs", href: "/" }, { label: displayName, href: `/signs/${currentAnimal.id}/` }]}
  articleSchema={true}
  faqSchema={faqs}
  dateModified="2026-08-19"
  ogImage={`/og/${currentAnimal.id}.png`}
>
  <!-- ===== HERO ===== -->
  <section class="relative overflow-hidden bg-zodiac-cream px-4 py-16 dark:bg-stone-950">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-transparent via-zodiac-gold/70 to-transparent"></div>
      <div class="absolute -top-32 left-1/2 h-72 w-[42rem] -translate-x-1/2 rounded-full bg-zodiac-red/15 blur-3xl"></div>
      <div class="absolute -bottom-40 left-1/2 h-72 w-[42rem] -translate-x-1/2 rounded-full bg-zodiac-gold/20 blur-3xl"></div>
      <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 select-none text-[24rem] font-bold leading-none text-zodiac-red/[0.04]" style="font-family: var(--font-cn)">{currentAnimal.chinese}</span>
    </div>
    <div class="relative mx-auto max-w-[760px] text-center">
      <div class="mb-6 flex items-center justify-center gap-3">
        <span class="h-px w-10 bg-gradient-to-r from-transparent to-zodiac-gold/70"></span>
        <span class="inline-flex items-center justify-center rounded-[5px] bg-zodiac-red px-2 py-1 text-xs font-bold tracking-widest text-white shadow-md shadow-red-900/20" style="font-family: var(--font-cn)">生肖</span>
        <span class="hidden text-[11px] font-semibold uppercase tracking-[0.35em] text-zodiac-gold sm:inline">Shēngxiào · {displayName}</span>
        <span class="h-px w-10 bg-gradient-to-l from-transparent to-zodiac-gold/70"></span>
      </div>
      <div class="mb-5 flex items-center justify-center">
        <span class="inline-flex h-20 w-20 items-center justify-center rounded-full border-2 border-zodiac-gold/40 bg-zodiac-cream text-5xl font-bold text-zodiac-deep shadow-md shadow-red-900/10 dark:border-zodiac-gold/20 dark:bg-stone-900 dark:text-zodiac-gold" style="font-family: var(--font-cn)">{currentAnimal.chinese}</span>
      </div>
      <h1 class="mb-3 font-display text-4xl font-bold tracking-tight text-zodiac-ink dark:text-stone-100 sm:text-5xl capitalize">
        The {displayName}: <span class="bg-gradient-to-r from-zodiac-deep via-zodiac-red to-zodiac-bronze bg-clip-text pb-1 text-transparent">{signMeta.h1Tagline}</span>
      </h1>
      <p class="mb-5 text-base text-stone-500 dark:text-stone-400">
        {currentAnimal.chinese} · {PINYIN[currentAnimal.id]} — the {currentAnimal.rank === 1 ? "1st" : currentAnimal.rank === 2 ? "2nd" : currentAnimal.rank === 3 ? "3rd" : `${currentAnimal.rank}th`} sign of the zodiac
      </p>
      <div class="flex flex-wrap items-center justify-center gap-2">
        <span class="rounded-full border border-zodiac-gold/30 bg-white/70 px-3.5 py-1.5 text-sm font-medium text-zodiac-deep dark:bg-stone-900/70 dark:text-zodiac-gold">{currentAnimal.element} Element</span>
        <span class="rounded-full border border-zodiac-gold/30 bg-white/70 px-3.5 py-1.5 text-sm font-medium text-zodiac-deep dark:bg-stone-900/70 dark:text-zodiac-gold">{currentAnimal.yinYang}</span>
        <span class="rounded-full border border-zodiac-gold/30 bg-white/70 px-3.5 py-1.5 text-sm font-medium text-zodiac-deep dark:bg-stone-900/70 dark:text-zodiac-gold">#{currentAnimal.rank} Sign</span>
      </div>
    </div>
  </section>

  <!-- ===== PERSONALITY ===== -->
  <section class="px-4 py-14">
    <div class="mx-auto max-w-[800px]">
      <h2 class="mb-6 font-display text-2xl font-bold tracking-tight text-zodiac-ink dark:text-stone-100">{displayName} Personality</h2>
      <div class="rounded-2xl border border-zodiac-gold/25 bg-white p-6 shadow-md shadow-red-900/10 dark:border-zodiac-gold/15 dark:bg-stone-900 sm:p-8">
        <p class="text-base leading-relaxed text-stone-600 dark:text-stone-400">{profile.personality}</p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl border border-zodiac-gold/15 bg-zodiac-cream/60 p-5 dark:border-zodiac-gold/10 dark:bg-stone-800/50">
            <h3 class="mb-2 text-xs font-semibold uppercase tracking-widest text-zodiac-red">Love &amp; Relationships</h3>
            <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-400">{profile.love}</p>
          </div>
          <div class="rounded-xl border border-zodiac-gold/15 bg-zodiac-cream/60 p-5 dark:border-zodiac-gold/10 dark:bg-stone-800/50">
            <h3 class="mb-2 text-xs font-semibold uppercase tracking-widest text-green-700 dark:text-green-400">Career &amp; Money</h3>
            <p class="text-sm leading-relaxed text-stone-600 dark:text-stone-400">{profile.career}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LUCKY THINGS + MATCHES ===== -->
  <section class="border-t border-zodiac-gold/15 bg-zodiac-cream/70 px-4 py-14 dark:border-zodiac-gold/10 dark:bg-stone-950">
    <div class="mx-auto max-w-[800px]">
      <h2 class="mb-6 font-display text-2xl font-bold tracking-tight text-zodiac-ink dark:text-stone-100">{displayName} Lucky Items &amp; Matches</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 dark:border-zodiac-gold/15 dark:bg-stone-900">
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-zodiac-red">Lucky Numbers</h3>
          <div class="flex flex-wrap gap-2">
            {lucky.numbers.map((n) => (
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-zodiac-red text-sm font-bold text-white">{n}</span>
            ))}
          </div>
        </div>
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 dark:border-zodiac-gold/15 dark:bg-stone-900">
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-zodiac-red">Lucky Colors</h3>
          <div class="flex flex-wrap gap-2">
            {lucky.colors.map((c) => (
              <span class="rounded-md bg-zodiac-gold/15 px-3 py-1.5 text-xs font-medium text-zodiac-bronze dark:bg-zodiac-gold/10 dark:text-amber-400">{c}</span>
            ))}
          </div>
        </div>
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 dark:border-zodiac-gold/15 dark:bg-stone-900">
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-zodiac-red">Lucky Flowers</h3>
          <div class="flex flex-wrap gap-2">
            {lucky.flowers.map((f) => (
              <span class="rounded-md bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-700 dark:bg-amber-900/20 dark:text-amber-400">{f}</span>
            ))}
          </div>
        </div>
      </div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 dark:border-zodiac-gold/15 dark:bg-stone-900">
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-zodiac-bronze dark:text-amber-400">Best Matches</h3>
          <div class="flex flex-wrap gap-2">
            {compat.best.map((b) => (
              <a href={`/signs/${b}/`} class="inline-flex items-center gap-1 rounded-full bg-zodiac-gold/15 px-3 py-1 text-xs font-medium text-zodiac-bronze no-underline transition-colors hover:bg-zodiac-gold/25 dark:bg-zodiac-gold/10 dark:text-amber-400 dark:hover:bg-zodiac-gold/20">{b.charAt(0).toUpperCase() + b.slice(1)}</a>
            ))}
          </div>
        </div>
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 dark:border-zodiac-gold/15 dark:bg-stone-900">
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest text-red-600 dark:text-red-400">Challenging Matches</h3>
          <div class="flex flex-wrap gap-2">
            {compat.worst.map((w) => (
              <a href={`/signs/${w}/`} class="inline-flex items-center gap-1 rounded-full bg-red-50 px-3 py-1 text-xs font-medium text-red-700 no-underline transition-colors hover:bg-red-100 dark:bg-red-900/20 dark:text-red-400 dark:hover:bg-red-900/30">{w.charAt(0).toUpperCase() + w.slice(1)}</a>
            ))}
          </div>
        </div>
      </div>
      <p class="mt-4 text-center text-xs text-stone-400 dark:text-stone-500">
        <a href="/compatibility/" class="font-medium text-zodiac-red underline-offset-2 hover:underline">Check any two signs&rsquo; compatibility &rarr;</a>
      </p>
    </div>
  </section>

  <!-- ===== BIRTH YEARS ===== -->
  <section class="px-4 py-14">
    <div class="mx-auto max-w-[800px]">
      <h2 class="mb-6 font-display text-2xl font-bold tracking-tight text-zodiac-ink dark:text-stone-100">{displayName} Birth Years</h2>
      <p class="mb-6 text-sm text-stone-500 dark:text-stone-400">
        The {displayName} year runs from one Chinese New Year to the next, not from January 1. Use the exact lunar ranges below to confirm your sign.
      </p>
      <div class="overflow-x-auto rounded-xl border border-zodiac-gold/25 shadow-md shadow-red-900/10 dark:border-zodiac-gold/15">
        <table class="w-full min-w-[500px] text-sm">
          <thead>
            <tr class="border-b border-zodiac-deep bg-zodiac-deep">
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-white/85">Year</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-white/85">Lunar Year Range</th>
            </tr>
          </thead>
          <tbody>
            {rangeEntry.ranges.slice(-6).reverse().map((r) => (
              <tr class="border-b border-zodiac-gold/15 last:border-b-0 transition-colors hover:bg-zodiac-cream/60 dark:border-zodiac-gold/10 dark:hover:bg-stone-800/50">
                <td class="px-4 py-3 font-medium text-zodiac-red">{r.year}</td>
                <td class="px-4 py-3 text-stone-600 dark:text-stone-400">{r.start}, {r.year} &ndash; {r.end}, {r.year + 1}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-center text-xs text-stone-400 dark:text-stone-500">
        Born between Jan 1 and the Chinese New Year? Use the <a href="/" class="font-medium text-zodiac-red underline-offset-2 hover:underline">calculator</a> with your full birth date for a precise result.
      </p>

      <div class="mt-8 rounded-2xl border border-zodiac-gold/25 bg-zodiac-cream/60 p-6 shadow-md shadow-red-900/10 dark:border-zodiac-gold/15 dark:bg-stone-900/50">
        <h3 class="mb-2 text-lg font-bold tracking-tight text-zodiac-ink dark:text-stone-100">Your Birth Year Element</h3>
        <p class="mb-4 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
          Your animal sign stays the same for life, but each birth year also carries its own heavenly-stem element — Wood, Fire, Earth, Metal, or Water. A {bornEras[bornEras.length - 2].year} Fire {displayName} and a {bornEras[bornEras.length - 1].year} {bornEras[bornEras.length - 1].element} {displayName} share the same sign, yet the element shapes how that nature shows up in personality and fortune.
        </p>
        <div class="overflow-x-auto rounded-xl border border-zodiac-gold/25 bg-white shadow-md shadow-red-900/10 dark:border-zodiac-gold/15 dark:bg-stone-900">
          <table class="w-full min-w-[420px] text-sm">
            <thead>
              <tr class="border-b border-zodiac-deep bg-zodiac-deep">
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-white/85">Birth Year</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-white/85">Element</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-white/85">Trait Focus</th>
              </tr>
            </thead>
            <tbody>
              {bornEras.map((e) => (
                <tr class="border-b border-zodiac-gold/15 last:border-b-0 transition-colors hover:bg-zodiac-cream/60 dark:border-zodiac-gold/10 dark:hover:bg-stone-800/50">
                  <td class="px-4 py-3 font-medium text-zodiac-red">{e.year}</td>
                  <td class="px-4 py-3 text-stone-700 dark:text-stone-300">{e.stem} · {e.element}</td>
                  <td class="px-4 py-3 text-stone-500 dark:text-stone-400">{ELEMENTS[e.element as keyof typeof ELEMENTS].traits}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-xs leading-relaxed text-stone-500 dark:text-stone-400">
          The stem-and-branch cycle repeats every 60 years. For a deeper look at how your element shapes your year, month, day, and hour of birth, try the <a href="/bazi-calculator/" class="font-medium text-zodiac-red underline-offset-2 hover:underline">BaZi Calculator</a> or explore the <a href="/elements/" class="font-medium text-zodiac-red underline-offset-2 hover:underline">five elements</a> in detail.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== 2026 HOROSCOPE ===== -->
  <section class="border-t border-zodiac-gold/15 bg-zodiac-cream/70 px-4 py-14 dark:border-zodiac-gold/10 dark:bg-stone-950">
    <div class="mx-auto max-w-[800px]">
      <h2 class="mb-6 font-display text-2xl font-bold tracking-tight text-zodiac-ink dark:text-stone-100">{displayName} — 2026 Horoscope</h2>
      <div class="rounded-2xl border border-zodiac-gold/25 bg-white p-6 shadow-md shadow-red-900/10 dark:border-zodiac-gold/15 dark:bg-stone-900 sm:p-8">
        <p class="text-base leading-relaxed text-stone-600 dark:text-stone-400">{horoscope}</p>
        <p class="mt-4 text-sm leading-relaxed text-stone-500 dark:text-stone-400">
          2026 is the Year of the Fire Horse, which begins February 17, 2026. For deeper annual guidance covering career, love, health, and wealth, explore the full <a href="/yearly-horoscope/" class="font-medium text-zodiac-red underline-offset-2 hover:underline">2026 horoscope guide</a> or calculate your personal <a href="/bazi-calculator/" class="font-medium text-zodiac-red underline-offset-2 hover:underline">BaZi chart</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== ALL SIGNS ===== -->
  <section class="px-4 py-14">
    <div class="mx-auto max-w-[900px]">
      <h2 class="mb-6 text-center font-display text-2xl font-bold tracking-tight text-zodiac-ink dark:text-stone-100">Explore All 12 Zodiac Signs</h2>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {otherAnimals.map((a) => (
          <a href={`/signs/${a.id}/`} class="group flex items-center gap-3 rounded-xl border border-zodiac-gold/25 bg-white px-4 py-3 shadow-sm transition-all hover:-translate-y-0.5 hover:border-zodiac-red/40 hover:shadow-md dark:border-zodiac-gold/15 dark:bg-stone-900">
            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-2 border-zodiac-gold/40 bg-zodiac-cream text-base font-bold text-zodiac-deep transition-colors group-hover:border-zodiac-red/60 group-hover:bg-zodiac-red group-hover:text-white dark:bg-stone-900 dark:text-zodiac-gold" style="font-family: var(--font-cn)">{a.chinese}</span>
            <span class="text-sm font-medium capitalize text-zodiac-ink transition-colors group-hover:text-zodiac-red dark:text-stone-100">{a.id}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="border-t border-zodiac-gold/15 bg-zodiac-cream/70 px-4 py-14 dark:border-zodiac-gold/10 dark:bg-stone-950">
    <div class="mx-auto max-w-[700px]">
      <h2 class="mb-8 text-center font-display text-2xl font-bold tracking-tight text-zodiac-ink dark:text-stone-100">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 transition-shadow hover:shadow-md dark:border-zodiac-gold/15 dark:bg-stone-900">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-zodiac-ink dark:text-stone-100">
              {f.q}
              <svg class="h-4 w-4 shrink-0 text-stone-400 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-400" set:html={f.a}></p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
