---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="relative mx-auto flex max-w-[600px] flex-col items-center justify-center overflow-hidden px-4 py-24 text-center">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-transparent via-zodiac-gold/70 to-transparent"></div>
      <div class="absolute -top-24 left-1/2 h-64 w-[36rem] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(220,38,38,0.15),transparent_70%)]"></div>
      <div class="absolute -bottom-32 left-1/2 h-64 w-[36rem] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(184,134,11,0.20),transparent_70%)]"></div>
    </div>
    <span class="relative bg-gradient-to-r from-zodiac-deep via-zodiac-red to-zodiac-bronze bg-clip-text text-[6rem] font-bold leading-none text-transparent md:text-[8rem]">404</span>
    <h1 class="relative mt-4 font-display text-2xl font-bold text-zodiac-ink dark:text-stone-100">Page Not Found</h1>
    <p class="relative mt-2 text-stone-500 dark:text-stone-400">The page you're looking for doesn't exist or has been moved.</p>
    <a href="/" class="relative mt-8 inline-flex items-center gap-2 rounded-lg bg-zodiac-red px-6 py-3 text-sm font-medium text-white no-underline transition-opacity hover:opacity-90">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M12 14L6 8L12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Back to Home
    </a>
  </div>
</BaseLayout>
