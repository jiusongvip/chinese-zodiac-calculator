---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact the Chinese-Zodiac-Calculator.com Team"
  description="Have a question about Chinese zodiac signs, compatibility, or our calculator? Get in touch with the Chinese-Zodiac-Calculator.com team and we will respond within 24 hours."
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Contact", href: "/contact" }]}
>
  <section class="mx-auto max-w-[640px] px-4 py-12 lg:px-6 lg:py-16">
    <div class="mb-8 text-center">
      <h1 class="mb-3 text-3xl font-bold tracking-tight text-stone-900 dark:text-stone-100 sm:text-4xl">Contact <span class="text-[#DC2626]">Us</span></h1>
      <p class="text-base text-stone-600 dark:text-stone-400">Have a question, suggestion, or feedback? We&#8217;d love to hear from you. Use the form below and we&#8217;ll get back to you within 24 hours — or email us directly at <a href="mailto:hello@chinese-zodiac-calculator.com" class="font-medium text-zodiac-red underline-offset-2 hover:underline">hello@chinese-zodiac-calculator.com</a>.</p>
    </div>

    <form id="contact-form" class="space-y-5">
      <div>
        <label for="name" class="mb-1 block text-sm font-medium text-stone-700 dark:text-stone-300">Name</label>
        <input type="text" id="name" name="name" required class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 outline-none transition-colors focus:border-[#DC2626] focus:ring-2 focus:ring-[#DC2626]/20 dark:border-stone-600 dark:bg-stone-800 dark:text-stone-100 dark:placeholder-stone-500" placeholder="Your name" />
      </div>
      <div>
        <label for="email" class="mb-1 block text-sm font-medium text-stone-700 dark:text-stone-300">Email</label>
        <input type="email" id="email" name="email" required class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 outline-none transition-colors focus:border-[#DC2626] focus:ring-2 focus:ring-[#DC2626]/20 dark:border-stone-600 dark:bg-stone-800 dark:text-stone-100 dark:placeholder-stone-500" placeholder="you@example.com" />
      </div>
      <div>
        <label for="message" class="mb-1 block text-sm font-medium text-stone-700 dark:text-stone-300">Message</label>
        <textarea id="message" name="message" rows="5" required class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 placeholder-stone-400 outline-none transition-colors focus:border-[#DC2626] focus:ring-2 focus:ring-[#DC2626]/20 dark:border-stone-600 dark:bg-stone-800 dark:text-stone-100 dark:placeholder-stone-500" placeholder="How can we help you?"></textarea>
      </div>
      <button type="submit" class="w-full rounded-lg bg-[#DC2626] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#B91C1C] focus:outline-none focus:ring-2 focus:ring-[#DC2626]/40">Send Message</button>
    </form>

    <p class="mt-4 text-center text-xs text-stone-500 dark:text-stone-500">
      Submitting opens your email app with the message pre-filled — no data is stored on our server. We typically respond within 24 hours.
    </p>
  </section>

  <script is:inline>
    // Static-site contact form: compose a mailto link from the form fields.
    // No backend required; swap for Formspree/Netlify Forms if a server-side endpoint is added later.
    (function () {
      var form = document.getElementById("contact-form");
      if (!form) return;
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        var name = document.getElementById("name").value.trim();
        var email = document.getElementById("email").value.trim();
        var message = document.getElementById("message").value.trim();
        var subject = "Website contact from " + (name || "a visitor");
        var body = message + "\n\n— " + name + " (" + email + ")";
        window.location.href =
          "mailto:hello@chinese-zodiac-calculator.com?subject=" +
          encodeURIComponent(subject) + "&body=" + encodeURIComponent(body);
      });
    })();
  </script>
</BaseLayout>
