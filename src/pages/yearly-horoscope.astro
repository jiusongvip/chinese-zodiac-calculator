---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ZODIAC_ANIMALS, ELEMENTS } from "../data/zodiac";

const getElement = (el: string): { years: number[]; color: string; traits: string } => (ELEMENTS as Record<string, { years: number[]; color: string; traits: string }>)[el];
const getHoroscope = (id: string): string => (horoscopes as Record<string, string>)[id];

const horoscopes = {
  rat: "The Rat shines in 2026 with career opportunities driven by quick thinking. Focus on networking to unlock financial gains.",
  ox: "Steady progress awaits the Ox in 2026. Your patience pays off professionally, but guard against stubbornness in relationships.",
  tiger: "2026 brings bold energy for the Tiger. Take calculated risks in love and career — ortune favors the brave this year.",
  rabbit: "A harmonious year for the Rabbit. Prioritize self-care and family; financial stability comes through cautious planning.",
  dragon: "The Dragon soars in 2026 with creative breakthroughs. Career expansion is favored, but watch your health amid the excitement.",
  snake: "Wisdom guides the Snake this year. Strategic moves in investments yield results. Trust your intuition in romantic matters.",
  horse: "As the ruling sign of 2026, the Horse enjoys a powerful year. Leadership opportunities abound; channel your fiery energy wisely.",
  goat: "A year of gentle growth for the Goat. Artistic pursuits flourish. Strengthen relationships through open communication.",
  monkey: "2026 rewards the Monkey's cleverness. New ventures succeed. Stay adaptable — nexpected changes bring hidden blessings.",
  rooster: "Precision and diligence elevate the Rooster in 2026. Career recognition arrives. Balance ambition with family time.",
  dog: "Loyalty brings rewards for the Dog this year. Legal and financial matters resolve favorably. Nurture your closest bonds.",
  pig: "The Pig enjoys abundance in 2026. Travel and education bring joy. Guard against overindulgence; maintain healthy routines.",
};

const faqs = [
  { q: "When does the Year of the Horse 2026 begin?", a: "The Chinese New Year for 2026 falls on February 17, 2026. Anyone born after this date belongs to the Horse sign. Those born before are still considered Snakes from the previous cycle." },
  { q: "Which zodiac sign has the best luck in 2026?", a: "The Horse (the ruling animal), Rat, and Dragon are considered the luckiest signs in 2026. Their elemental alignments harmonize well with the Fire element of the Horse year." },
  { q: "What element is 2026 in Chinese zodiac?", a: "2026 is a Fire Horse year. Fire represents passion, energy, and transformation. Combined with the Horse's dynamic nature, this creates a year of intense momentum and change." },
  { q: "Is 2026 a good year for marriage?", a: "The Horse year is generally favorable for weddings, especially for those born under Rat, Dragon, Monkey, and Dog signs. Consult the compatibility chart for personalized guidance." },
  { q: "How accurate are yearly zodiac horoscopes?", a: "Yearly horoscopes provide general guidance based on your animal sign and element. For a more precise reading, consider your BaZi (Four Pillars of Destiny) chart, which factors in your exact birth date and time." },
];
---

<BaseLayout
  title="2026 Chinese Zodiac Horoscope Guide"
  description="Read your 2026 Chinese zodiac horoscope with free annual predictions for all 12 signs covering career, love, health, and wealth. Plan your year ahead."
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Horoscope", href: "/yearly-horoscope" }]}
  articleSchema={true}
>
  <section class="mx-auto max-w-[1200px] px-4 py-12 lg:px-6 lg:py-16">
    <div class="mx-auto mb-12 max-w-[720px] text-center">
      <h1 class="mb-4 text-3xl font-bold tracking-tight text-stone-900 dark:text-stone-100 sm:text-4xl">2026 Year of the <span class="text-[#DC2626]">Horse</span> — odiac Horoscopes</h1>
      <p class="text-base leading-relaxed text-stone-600 dark:text-stone-400">Fire Horse 2026 brings bold energy, transformation, and opportunity for all twelve signs. Discover what the year holds for your career, love life, health, and finances.</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {ZODIAC_ANIMALS.map((animal) => {
        const preview = getHoroscope(animal.id);
        const elem = getElement(animal.element);
        return (
          <article class="group rounded-xl border border-stone-200 bg-white p-6 shadow-sm transition-all hover:shadow-md hover:border-[#DC2626]/30 dark:border-stone-700 dark:bg-stone-800 dark:hover:border-[#DC2626]/50">
            <div class="mb-3 flex items-center justify-between">
              <span class="text-2xl font-bold text-stone-900 dark:text-stone-100 capitalize">{animal.chinese} {animal.id}</span>
              <span class="rounded-full px-3 py-1 text-xs font-medium" style={`background-color: ${elem.color}20; color: ${elem.color};`}>{animal.element}</span>
            </div>
            <p class="mb-4 text-sm leading-relaxed text-stone-600 dark:text-stone-400">{preview}</p>
            <a href={`/signs/${animal.id}/`} class="inline-flex items-center gap-1 text-sm font-medium text-[#DC2626] hover:underline">Read full horoscope &rarr;</a>
          </article>
        );
      })}
    </div>
  </section>

  <section class="border-t border-stone-200 bg-stone-50 dark:border-stone-800 dark:bg-stone-900/50">
    <div class="mx-auto max-w-[800px] px-4 py-12 lg:px-6 lg:py-16">
      <h2 class="mb-8 text-2xl font-bold text-stone-900 dark:text-stone-100 text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq, _i) => (
          <details class="group cursor-pointer rounded-lg border border-stone-200 bg-white p-5 dark:border-stone-700 dark:bg-stone-800">
            <summary class="flex items-center justify-between text-sm font-semibold text-stone-900 dark:text-stone-100 [&::-webkit-details-marker]:hidden">
              {faq.q}
              <svg class="h-4 w-4 shrink-0 text-stone-400 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-400">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
