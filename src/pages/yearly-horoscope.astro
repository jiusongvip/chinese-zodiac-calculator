---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ZODIAC_ANIMALS, ELEMENTS, HOROSCOPES_2026_DETAIL } from "../data/zodiac";

const getElement = (el: string): { years: number[]; color: string; traits: string } => (ELEMENTS as Record<string, { years: number[]; color: string; traits: string }>)[el];
const horoscopes = HOROSCOPES_2026_DETAIL;

const areas = [
  { key: "career", label: "Career" },
  { key: "love", label: "Love" },
  { key: "health", label: "Health" },
  { key: "wealth", label: "Wealth" },
] as const;

const faqs = [
  { q: "When does the Year of the Horse 2026 begin?", a: "The Chinese New Year for 2026 falls on February 17, 2026. Anyone born after this date belongs to the Horse sign. Those born before are still considered Snakes from the previous cycle." },
  { q: "Which zodiac sign has the best luck in 2026?", a: "The Horse (the ruling animal), Rat, and Dragon are considered the luckiest signs in 2026. Their elemental alignments harmonize well with the Fire element of the Horse year." },
  { q: "What element is 2026 in Chinese zodiac?", a: "2026 is a Fire Horse year. Fire represents passion, energy, and transformation. Combined with the Horse's dynamic nature, this creates a year of intense momentum and change." },
  { q: "Is 2026 a good year for marriage?", a: "The Horse year is generally favorable for weddings, especially for those born under Rat, Dragon, Monkey, and Dog signs. Consult the compatibility chart for personalized guidance." },
  { q: "How accurate are yearly zodiac horoscopes?", a: "Yearly horoscopes provide general guidance based on your animal sign and element. For a more precise reading, consider your BaZi (Four Pillars of Destiny) chart, which factors in your exact birth date and time." },
];
---

<BaseLayout
  title="2026 Chinese Zodiac Horoscope Guide"
  description="Read your 2026 Chinese zodiac horoscope with free annual predictions for all 12 signs covering career, love, health, and wealth. Plan your year ahead."
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Horoscope", href: "/yearly-horoscope/" }]}
  articleSchema={true}
  faqSchema={faqs}
  dateModified="2026-08-19"
>
  <section class="relative mx-auto max-w-[1200px] px-4 py-12 lg:px-6 lg:py-16">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-transparent via-zodiac-gold/70 to-transparent" aria-hidden="true"></div>
    <div class="mx-auto mb-12 max-w-[720px] text-center">
      <div class="mb-6 flex items-center justify-center gap-3">
        <span class="h-px w-10 bg-gradient-to-r from-transparent to-zodiac-gold/70"></span>
        <span class="inline-flex items-center justify-center rounded-[5px] bg-zodiac-red px-2 py-1 text-xs font-bold tracking-widest text-white shadow-md shadow-red-900/20" style="font-family: var(--font-cn)">运势</span>
        <span class="hidden text-[11px] font-semibold uppercase tracking-[0.35em] text-zodiac-gold sm:inline">Yùnshì</span>
        <span class="h-px w-10 bg-gradient-to-l from-transparent to-zodiac-gold/70"></span>
      </div>
      <h1 class="font-display text-3xl font-bold tracking-tight text-zodiac-ink dark:text-stone-100 sm:text-4xl">2026 Year of the <span class="bg-gradient-to-r from-zodiac-deep via-zodiac-red to-zodiac-bronze bg-clip-text pb-1 text-transparent">Horse</span> — Chinese Zodiac Horoscopes</h1>
      <p class="text-base leading-relaxed text-stone-600 dark:text-stone-400">Fire Horse 2026 brings bold energy, transformation, and opportunity for all twelve signs. Discover what the year holds for your career, love life, health, and finances.</p>
    </div>

    <h2 class="mb-8 text-center text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-100">2026 Horoscopes for All 12 Chinese Zodiac Signs</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {ZODIAC_ANIMALS.map((animal) => {
        const preview = horoscopes[animal.id as keyof typeof horoscopes];
        const elem = getElement(animal.element);
        return (
          <article class="flex flex-col rounded-xl border border-zodiac-gold/25 bg-white p-6 shadow-sm transition-all hover:shadow-md hover:border-zodiac-red/40 dark:border-zodiac-gold/15 dark:bg-stone-800 dark:hover:border-zodiac-red/50">
            <div class="mb-3 flex items-center justify-between">
              <span class="text-2xl font-bold text-stone-900 dark:text-stone-100 capitalize">{animal.chinese} {animal.id}</span>
              <span class="rounded-full px-3 py-1 text-xs font-medium" style={`background-color: ${elem.color}20; color: ${elem.color};`}>{animal.element}</span>
            </div>
            <p class="mb-4 text-sm leading-relaxed text-stone-600 dark:text-stone-400">{preview.summary}</p>
            <dl class="mb-5 space-y-3">
              {areas.map((area) => (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-widest text-zodiac-red">{area.label}</dt>
                  <dd class="mt-0.5 text-sm leading-relaxed text-stone-600 dark:text-stone-400">{preview[area.key]}</dd>
                </div>
              ))}
            </dl>
            <a href={`/signs/${animal.id}/`} class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-zodiac-red hover:underline">Read full profile &rarr;</a>
          </article>
        );
      })}
    </div>
  </section>

  <section class="border-t border-zodiac-gold/15 bg-zodiac-cream/70 dark:border-zodiac-gold/10 dark:bg-stone-900/50">
    <div class="mx-auto max-w-[800px] px-4 py-12 lg:px-6 lg:py-16">
      <h2 class="mb-6 text-center text-2xl font-bold text-stone-900 dark:text-stone-100">What the Fire Horse Year Means in 2026</h2>
      <p class="mx-auto mb-10 max-w-[720px] text-center text-sm leading-relaxed text-stone-600 dark:text-stone-400">In Chinese astrology, each year pairs one of twelve animals with one of five elements. 2026 combines the Horse with Fire: expect fast-moving change, bold opportunities, and heated tempers. The predictions above show how that energy plays out for each sign's career, love life, health, and wealth — pick your sign to see the full picture.</p>
      <h2 class="mb-8 text-2xl font-bold text-stone-900 dark:text-stone-100 text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((faq, _i) => (
          <details class="group cursor-pointer rounded-lg border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 dark:border-zodiac-gold/15 dark:bg-stone-800">
            <summary class="flex items-center justify-between text-sm font-semibold text-stone-900 dark:text-stone-100 [&::-webkit-details-marker]:hidden">
              {faq.q}
              <svg class="h-4 w-4 shrink-0 text-stone-400 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-400">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
