---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ZODIAC_ANIMALS } from "../data/zodiac";

const earthlyBranches = [
  { branch: "子 (zǐ)", animal: "Rat" },
  { branch: "丑 (chǒu)", animal: "Ox" },
  { branch: "寅 (yín)", animal: "Tiger" },
  { branch: "卯 (mǎo)", animal: "Rabbit" },
  { branch: "辰 (chén)", animal: "Dragon" },
  { branch: "巳 (sì)", animal: "Snake" },
  { branch: "午 (wǔ)", animal: "Horse" },
  { branch: "未 (wèi)", animal: "Goat" },
  { branch: "申 (shēn)", animal: "Monkey" },
  { branch: "酉 (yǒu)", animal: "Rooster" },
  { branch: "戌 (xū)", animal: "Dog" },
  { branch: "亥 (hài)", animal: "Pig" },
];

const faqs = [
  { q: "Why is the Cat not in the Chinese zodiac?", a: "The most popular legend: the Cat and the Rat were neighbors when the Jade Emperor announced his race to select the zodiac animals. The Cat loved sleeping and asked the Rat to wake him on race day. The Rat agreed — but either forgot or deliberately left the Cat asleep. The Cat missed the race entirely, and the two have been enemies ever since. This is why, in Chinese culture, cats and rats are natural foes. (In the Vietnamese zodiac, the Cat actually replaces the Rabbit — one of the rare differences between zodiac systems.)" },
  { q: "Why is the Rat the first zodiac animal?", a: "The classic legend: the Ox was the strongest swimmer and took the lead crossing the river. The tiny Rat rode on the Ox's back, and at the final moment jumped ashore first, winning first place. The Jade Emperor was amused by the Rat's cleverness and awarded it the first position. This story celebrates wit over strength — a favorite moral in Chinese folklore. Some versions say the Rat hid in the Ox's ear or nose rather than on its back." },
  { q: "When was the Chinese zodiac invented?", a: "The twelve animals as a system developed gradually. The earliest evidence of animal-year counting appears on bamboo slips from roughly 300 BC (the Shuihudi Qin bamboo texts, excavated in 1975 in Hubei), though some animals differed from today's list. By the Eastern Han dynasty (around the 1st century AD), the full twelve-animal list matching today's zodiac was documented in Wang Chong's Lunheng. The system combines the ten Heavenly Stems, twelve Earthly Branches, and the twelve-year cycle of Jupiter (the Year Star), which has been observed since ancient times." },
  { q: "Why are these 12 animals specifically?", a: "The twelve animals correspond to the twelve Earthly Branches (子丑寅卯…) and were chosen from everyday animals familiar in ancient China: six domestic animals (ox, horse, goat, rooster, dog, pig), wild animals (tiger, rabbit, monkey, rat, snake), and one mythical creature — the Dragon, which represents power, rain, and the emperor. The exact selection process is lost to history, but the animals' practical and symbolic roles in agrarian Chinese life made them natural choices." },
  { q: "Is the Chinese zodiac the same in all countries?", a: "Mostly, but not entirely. The Vietnamese zodiac replaces the Rabbit with the Cat (so 2023 was Cat year in Vietnam, Rabbit year elsewhere). Thailand's northern tradition sometimes uses the Naga serpent instead of the Dragon, and the pig is replaced by an elephant in some regional versions. Japan uses the same twelve animals, with the Boar for the Pig. These variations show how the zodiac traveled across Asia and adapted to local cultures." },
  { q: "Does the zodiac go by the lunar calendar or the solar year?", a: "The zodiac follows the Chinese lunar calendar. The sign changes at Chinese New Year (the first day of the lunar year), which falls between January 21 and February 20 in the Gregorian calendar. A smaller convention uses Lichun (Start of Spring, around February 4) as the boundary. Our <a href=\"/\" class=\"font-medium text-zodiac-red underline-offset-2 hover:underline\">calculator</a> uses the mainstream Lunar New Year convention with exact dates from 1900 to 2035." },
];

const raceSteps = [
  { step: "1", title: "The Emperor's Announcement", text: "The Jade Emperor — or in some versions, the Buddha — decided the years should be named after animals. He announced a great race across a wide river: the first twelve animals to reach the far shore would each earn a year in the zodiac cycle." },
  { step: "2", title: "The Clever Alliance", text: "The Cat and the Rat, close friends, agreed to help each other. The Cat, who loved sleeping, asked the Rat to wake him on race morning. The Rat promised — but the morning came and the Rat left without him, and the Cat missed the race entirely. That is why cats chase rats to this day." },
  { step: "3", title: "The Ox Takes the Lead", text: "The strong, steady Ox swam powerfully across the river and was first by far. But the tiny Rat had quietly climbed onto the Ox's back. As the Ox reached the shore, the Rat leaped off and crossed the finish line first, winning the first year." },
  { step: "4", title: "Order by Arrival", text: "The Ox came second, the Tiger third (fighting the current), the Rabbit fourth (hopping across stones), the Dragon fifth (it could have flown but stopped to help villagers), and the Snake, Horse, Goat, Monkey, Rooster, Dog, and Pig followed in that order — each with its own famous reason." },
];

const historyPoints = [
  { period: "c. 300 BC", title: "Earliest evidence — Shuihudi bamboo slips", text: "Excavated in 1975 at Shuihudi, Hubei, these Qin-era bamboo slips (日书, daybooks) record animal years used for divination. Some animals differ from today's list — the snake appears as 'worm,' and the horse as 'deer' — showing the system was still evolving." },
  { period: "1st century AD", title: "The twelve animals as we know them", text: "The philosopher Wang Chong's Lunheng (论衡) documents the complete twelve-animal cycle matching the modern zodiac, firmly linking each animal to its Earthly Branch (子鼠, 丑牛, 寅虎…)." },
  { period: "Han Dynasty", title: "Stems, branches, and Jupiter", text: "The zodiac fused with the ten Heavenly Stems (天干) and twelve Earthly Branches (地支), creating the 60-year cycle still used today. The twelve branches also mirror Jupiter's roughly 12-year orbit — the 'Year Star' (岁星) that Chinese astronomers tracked for calendrical and political purposes." },
  { period: "Modern era", title: "A living tradition", text: "The zodiac spread across East and Southeast Asia, spawning regional variants (Vietnam's Cat, Thailand's Naga). Today it remains central to calendars, marriage compatibility, naming, and yearly fortune traditions — including Ben Ming Nian and Tai Sui." },
];
---

<BaseLayout
  title="Zodiac Origin Story: The Great Race & History"
  description="Where does the Chinese zodiac come from? Discover the Great Race legend, why the Rat came first, why the Cat is missing, and the real history."
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Zodiac Origin", href: "/zodiac-origin/" }]}
  articleSchema={true}
  faqSchema={faqs}
  dateModified="2026-08-19"
  ogImage="/og/zodiac-origin.png"
>
  <article class="relative mx-auto max-w-[1000px] px-4 py-12 lg:px-6 lg:py-16">
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-transparent via-zodiac-gold/70 to-transparent" aria-hidden="true"></div>
    <!-- Hero -->
    <header class="text-center">
      <div class="mb-6 flex items-center justify-center gap-3">
        <span class="h-px w-10 bg-gradient-to-r from-transparent to-zodiac-gold/70"></span>
        <span class="inline-flex items-center justify-center rounded-[5px] bg-zodiac-red px-2 py-1 text-xs font-bold tracking-widest text-white shadow-md shadow-red-900/20" style="font-family: var(--font-cn)">缘起</span>
        <span class="hidden text-[11px] font-semibold uppercase tracking-[0.35em] text-zodiac-bronze dark:text-zodiac-gold sm:inline">Yuánqǐ</span>
        <span class="h-px w-10 bg-gradient-to-l from-transparent to-zodiac-gold/70"></span>
      </div>
      <h1 class="font-display text-3xl font-bold tracking-tight text-zodiac-ink dark:text-stone-100 md:text-4xl">
        The Origin of the <span class="bg-gradient-to-r from-zodiac-deep via-zodiac-red to-zodiac-bronze bg-clip-text pb-1 text-transparent">Chinese Zodiac</span>
      </h1>
      <p class="mx-auto mt-3 max-w-[680px] text-base leading-relaxed text-stone-500 dark:text-stone-400">
        The Great Race legend, why the Rat came first and the Cat was left behind — plus what archaeology actually tells us about the zodiac's 2,000-year history.
      </p>
    </header>

    <!-- The Legend -->
    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">The Legend: The Great Race</h2>
      <p class="mt-2 text-sm text-stone-500 dark:text-stone-400">
        The most beloved origin story of the Chinese zodiac — a tale of wit, loyalty, and one very sleepy cat.
      </p>
      <div class="mt-6 space-y-4">
        {raceSteps.map((s) => (
          <div class="flex gap-4 rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 dark:border-zodiac-gold/15 dark:bg-stone-800">
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-zodiac-red/10 text-lg font-bold text-zodiac-red">{s.step}</span>
            <div>
              <h3 class="text-base font-semibold text-zodiac-ink dark:text-stone-100">{s.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{s.text}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-4 text-sm leading-relaxed text-stone-500 dark:text-stone-400">
        There are many versions of the story — the Buddha's banquet, the Jade Emperor's palace selection, a river crossing in the Vietnamese telling. What they share is the moral: cleverness and cooperation matter as much as raw strength, and the order of the twelve animals encodes that lesson.
      </p>
    </section>

    <!-- The 12 animals table -->
    <section class="mt-12 rounded-2xl bg-zodiac-cream/70 p-6 dark:bg-stone-800/50 sm:p-8">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">The Twelve Animals &amp; Their Earthly Branches</h2>
      <p class="mt-2 text-sm text-stone-500 dark:text-stone-400">
        Each animal is permanently paired with one of the twelve Earthly Branches used to count years, months, days, and hours.
      </p>
      <div class="mt-6 overflow-x-auto rounded-xl border border-zodiac-gold/25 shadow-md shadow-red-900/10 dark:border-zodiac-gold/15">
        <table class="w-full min-w-[500px] text-sm">
          <thead>
            <tr class="border-b border-zodiac-deep bg-zodiac-deep">
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-white/85">Order</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-white/85">Animal</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-white/85">Earthly Branch</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-white/85">Recent Years</th>
            </tr>
          </thead>
          <tbody>
            {earthlyBranches.map((e, i) => {
              const animal = ZODIAC_ANIMALS[i];
              return (
                <tr class="border-b border-zodiac-gold/15 last:border-b-0 transition-colors hover:bg-zodiac-cream/60 dark:border-zodiac-gold/10 dark:hover:bg-stone-800/50">
                  <td class="px-4 py-3 font-medium text-zodiac-red">{i + 1}</td>
                  <td class="px-4 py-3 capitalize">
                    <a href={`/signs/${animal.id}/`} class="font-medium text-zodiac-ink no-underline transition-colors hover:text-zodiac-red dark:text-stone-200 dark:hover:text-zodiac-red">{animal.chinese} {e.animal}</a>
                  </td>
                  <td class="px-4 py-3 text-stone-600 dark:text-stone-400">{e.branch}</td>
                  <td class="px-4 py-3 text-stone-500 dark:text-stone-400">{animal.id === "rat" ? "2020, 2032" : animal.id === "ox" ? "2021, 2033" : animal.id === "tiger" ? "2022, 2034" : animal.id === "rabbit" ? "2023, 2035" : animal.id === "dragon" ? "2024, 2036" : animal.id === "snake" ? "2025, 2037" : animal.id === "horse" ? "2026, 2038" : animal.id === "goat" ? "2027, 2039" : animal.id === "monkey" ? "2028, 2040" : animal.id === "rooster" ? "2029, 2041" : animal.id === "dog" ? "2030, 2042" : "2031, 2043"}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- History -->
    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">What History Tells Us</h2>
      <p class="mt-2 text-sm text-stone-500 dark:text-stone-400">
        Beyond legend, archaeology and written records trace the zodiac's real development over more than two millennia.
      </p>
      <div class="mt-6 space-y-6">
        {historyPoints.map((h) => (
          <div class="rounded-xl border border-zodiac-gold/25 bg-white p-6 shadow-md shadow-red-900/10 dark:border-zodiac-gold/15 dark:bg-stone-800">
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full bg-zodiac-red/10 px-3 py-1 text-xs font-semibold text-zodiac-red">{h.period}</span>
              <h3 class="text-base font-semibold text-zodiac-ink dark:text-stone-100">{h.title}</h3>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-300">{h.text}</p>
          </div>
        ))}
      </div>
      <p class="mt-4 text-sm leading-relaxed text-stone-500 dark:text-stone-400">
        The zodiac was never created in a single moment. It grew from ancient Chinese astronomy (Jupiter's 12-year cycle), the counting systems of the Heavenly Stems and Earthly Branches, and folk storytelling that gave each year a familiar animal face.
      </p>
      <blockquote class="mt-6 rounded-xl border-l-4 border-zodiac-red bg-zodiac-cream/60 p-5 dark:border-zodiac-red/60 dark:bg-stone-800/60">
        <p class="text-sm italic leading-relaxed text-stone-700 dark:text-stone-300">&ldquo;The 12 animals in order are: Rat, Ox, Tiger, Rabbit, Dragon, Snake, Horse, Goat, Monkey, Rooster, Dog, and Pig. Each year in the cycle corresponds to one of these animals, together with one of the five elements.&rdquo;</p>
        <cite class="mt-2 block text-xs not-italic text-stone-500 dark:text-stone-500">— <a href="https://www.britannica.com/topic/Chinese-zodiac" rel="noopener" target="_blank" class="font-medium text-zodiac-red underline-offset-2 hover:underline">Encyclopædia Britannica</a>, &ldquo;Chinese zodiac&rdquo;</cite>
      </blockquote>
    </section>

    <!-- Regional variants -->
    <section class="mt-12 rounded-2xl bg-zodiac-cream/70 p-6 dark:bg-stone-800/50 sm:p-8">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">The Zodiac Around Asia</h2>
      <p class="mt-2 text-sm text-stone-500 dark:text-stone-400">
        As the zodiac spread across Asia, each culture adapted it to local animals and beliefs.
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 dark:border-zodiac-gold/15 dark:bg-stone-800">
          <h3 class="text-sm font-semibold text-zodiac-ink dark:text-stone-100">Vietnam — the Cat replaces the Rabbit</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">Vietnamese farmers valued cats for protecting rice harvests from rats, so the zodiac adopted the Cat (Mão) where China uses the Rabbit. 2023 was the Year of the Cat in Vietnam.</p>
        </div>
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 dark:border-zodiac-gold/15 dark:bg-stone-800">
          <h3 class="text-sm font-semibold text-zodiac-ink dark:text-stone-100">Thailand — the Naga serpent</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">Northern Thai tradition sometimes replaces the Dragon with the Naga, a mythical water serpent from local Buddhist and Hindu mythology — a fitting guardian for a river-centered culture.</p>
        </div>
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 dark:border-zodiac-gold/15 dark:bg-stone-800">
          <h3 class="text-sm font-semibold text-zodiac-ink dark:text-stone-100">Japan — the Boar for the Pig</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">Japan follows the same twelve animals but names the last one Inoshishi (wild boar) rather than the domesticated Pig. The zodiac arrived via Korea with Buddhism and took root in the imperial calendar.</p>
        </div>
        <div class="rounded-xl border border-zodiac-gold/25 bg-white p-5 dark:border-zodiac-gold/15 dark:bg-stone-800">
          <h3 class="text-sm font-semibold text-zodiac-ink dark:text-stone-100">Korea — shared heritage, own flavor</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-300">Korea shares the twelve animals and their order, but the zodiac carries distinct local meanings — the tiger plays a far larger role in Korean folklore as the mountain spirit and national symbol.</p>
        </div>
      </div>
    </section>

    <!-- Explore signs -->
    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">Explore Each Animal's Profile</h2>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {ZODIAC_ANIMALS.map((a) => (
          <a href={`/signs/${a.id}/`} class="group flex items-center gap-3 rounded-xl border border-zodiac-gold/25 bg-white px-4 py-3 shadow-sm transition-all hover:-translate-y-0.5 hover:border-zodiac-red/40 hover:shadow-md dark:border-zodiac-gold/15 dark:bg-stone-900">
            <span class="text-xl">{a.chinese}</span>
            <span class="text-sm font-medium capitalize text-zodiac-ink transition-colors group-hover:text-zodiac-red dark:text-stone-100">{a.id}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="mt-12">
      <h2 class="text-2xl font-semibold tracking-tight text-zodiac-ink dark:text-stone-100">Frequently Asked Questions</h2>
      <div class="mt-6 space-y-3">
        {faqs.map((f) => (
          <details class="group rounded-xl border border-zodiac-gold/25 bg-white p-5 shadow-sm shadow-red-900/5 transition-shadow hover:shadow-md dark:border-zodiac-gold/15 dark:bg-stone-800">
            <summary class="flex cursor-pointer items-center justify-between font-medium text-zodiac-ink dark:text-stone-100">
              {f.q}
              <svg class="h-4 w-4 shrink-0 text-stone-500 transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none"><path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-stone-600 dark:text-stone-400" set:html={f.a}></p>
          </details>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
